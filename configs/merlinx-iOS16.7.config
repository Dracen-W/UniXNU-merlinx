# UniXNU-merlinx iOS 16.7.16 (20H392, iPhone10,6 / d221ap) override configuration.
# Layer order: MT6768-common/configs/mt6768.config -> configs/merlinx_defconfig -> configs/merlinx-iOS16.7.config
# Every CONFIG_XNU_DW_* parameter set here takes final precedence over general and sub-repo defaults.

# --- Target OS & APFS Volume UUIDs (Single Source of Truth) ---
CONFIG_XNU_DW_OS_BUILD="20H392"
CONFIG_XNU_DW_APFS_OS_UUID="DADD93F8-DBBF-4B17-A1DF-0F11E64172F7"
CONFIG_XNU_DW_APFS_SYSTEMOS_UUID="96096B28-B6DC-4BC7-9D3A-2632A0FE53F1"
CONFIG_XNU_DW_APFS_DATA_UUID="8C87541D-CA80-4176-B6B4-A11FD2984A32"

# Keep legacy XNU_* volume UUID variables synchronized automatically
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="8C87541D-CA80-4176-B6B4-A11FD2984A32"
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="96096B28-B6DC-4BC7-9D3A-2632A0FE53F1"

# --- NativeEmmc (Dracen-W/NativeEmmc) ---
CONFIG_XNU_DW_NATIVEEMMC_OS_UUID="DADD93F8-DBBF-4B17-A1DF-0F11E64172F7"
CONFIG_XNU_DW_NATIVEEMMC_SYSTEMOS_UUID="96096B28-B6DC-4BC7-9D3A-2632A0FE53F1"
CONFIG_XNU_DW_NATIVEEMMC_TRANSFER_BLOCKS=2048
CONFIG_XNU_DW_NATIVEEMMC_SPIN_POLLS=4096
CONFIG_XNU_DW_NATIVEEMMC_USERDATA_LBA=20332544
CONFIG_XNU_DW_NATIVEEMMC_USERDATA_BYTES=114597789696

# --- Mali-G52 Kernel Service (Dracen-W/Mali-G52) ---
CONFIG_XNU_DW_MALIG52_M2_WRITES=y
CONFIG_XNU_DW_MALIG52_M3_WRITES=y
CONFIG_XNU_DW_MALIG52_M4_WRITES=y
CONFIG_XNU_DW_MALIG52_M6_WRITES=y
CONFIG_XNU_DW_MALIG52_LOG_LEVEL=1

# --- MaliMetal Userspace Stack (Dracen-W/MaliMetal) ---
CONFIG_XNU_DW_MALIMETAL_TARGET_OS="ios16"
CONFIG_XNU_DW_MALIMETAL_IOS_MIN="16.0"
CONFIG_XNU_DW_MALIMETAL_MTLDEVICE_SIZE=0
CONFIG_XNU_DW_MALIMETAL_TRACE=n

# --- MT6768 SoC (Dracen-W/UniXNU-MT6768-common) ---
CONFIG_XNU_DW_MT6768_SMP=y
CONFIG_XNU_DW_MT6768_CPUS=8
CONFIG_XNU_DW_MT6768_EL2_DROP=y
CONFIG_XNU_DW_MT6768_FLUSH_TTEP=y
CONFIG_XNU_DW_MT6768_WORKQUEUE_PARALLEL=y

# --- Display (External GopFramebuffer build-time ABI adaptation) ---
# iOS 16.7.16 IOMobileFramebufferUserClient selector 74 passes 3 explicit args to supportedFrameInfo.
CONFIG_XNU_DW_DISPLAY_IOS16_SFI_ABI=y
CONFIG_XNU_DW_DISPLAY_INTERPOSE=n

# --- FocalTech FT8719 Touch (Dracen-W/FocalTechTouch-FT8719) ---
CONFIG_XNU_DW_FOCALTECH_SPI_HZ=8000000
CONFIG_XNU_DW_FOCALTECH_SPI_CS=0
CONFIG_XNU_DW_FOCALTECH_RESET_GPIO=92
CONFIG_XNU_DW_FOCALTECH_IRQ_GPIO=1
CONFIG_XNU_DW_FOCALTECH_X_MAX=1080
CONFIG_XNU_DW_FOCALTECH_Y_MAX=2340
CONFIG_XNU_DW_FOCALTECH_MAX_POINTS=10
CONFIG_XNU_DW_FOCALTECH_SWAP_XY=0
CONFIG_XNU_DW_FOCALTECH_INVERT_X=0
CONFIG_XNU_DW_FOCALTECH_INVERT_Y=0
