+#ifndef MDEPKG_NDEBUG
+STATIC
+VOID
+EFIAPI
+ProbeFat (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_STATUS                       Status;
+  EFI_HANDLE                       *Handles;
+  UINTN                            HandleCount;
+  UINTN                            Index;
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *FileSystem;
+  EFI_FILE_PROTOCOL                *Root;
+  EFI_FILE_PROTOCOL                *File;
+  CHAR8                            Data[64];
+  UINTN                            Size;
+  BOOLEAN                          Found;
+
+  if (mFatProbeDone) {
+    if (mFatProbeTimer != NULL) {
+      gBS->SetTimer (mFatProbeTimer, TimerCancel, 0);
+    }
+
+    return;
+  }
+
+  Handles     = NULL;
+  HandleCount = 0;
+  Found       = FALSE;
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiSimpleFileSystemProtocolGuid,
+                  NULL,
+                  &HandleCount,
+                  &Handles
+                  );
+  DEBUG ((DEBUG_ERROR, "MERLINXMEM: FAT filesystems %lu, %r\n", (UINT64)HandleCount, Status));
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    Status = gBS->HandleProtocol (
+                    Handles[Index],
+                    &gEfiSimpleFileSystemProtocolGuid,
+                    (VOID **)&FileSystem
+                    );
+    if (EFI_ERROR (Status)) {
+      continue;
+    }
+
+    Status = FileSystem->OpenVolume (FileSystem, &Root);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "MERLINXMEM: FAT open volume %r\n", Status));
+      continue;
+    }
+
+    Status = Root->Open (Root, &File, L"\\HELLO.TXT", EFI_FILE_MODE_READ, 0);
+    if (EFI_ERROR (Status)) {
+      Root->Close (Root);
+      continue;
+    }
+
+    ZeroMem (Data, sizeof (Data));
+    Size   = sizeof (Data) - 1;
+    Status = File->Read (File, &Size, Data);
+    if (!EFI_ERROR (Status)) {
+      Data[Size] = '\0';
+      DEBUG ((DEBUG_ERROR, "MERLINXMEM: HELLO.TXT %lu bytes: %a\n", (UINT64)Size, Data));
+      Found         = TRUE;
+      mFatProbeDone = TRUE;
+      if (mFatProbeTimer != NULL) {
+        gBS->SetTimer (mFatProbeTimer, TimerCancel, 0);
+      }
+    } else {
+      DEBUG ((DEBUG_ERROR, "MERLINXMEM: HELLO.TXT read %r\n", Status));
+    }
+
+    File->Close (File);
+    Root->Close (Root);
+  }
+
+  if (Handles != NULL) {
+    gBS->FreePool (Handles);
+  }
+
+  if (!Found) {
+    DEBUG ((DEBUG_ERROR, "MERLINXMEM: HELLO.TXT not found\n"));
+    return;
+  }
+
+  gBS->Stall (3 * 1000 * 1000);
+}
+#endif
