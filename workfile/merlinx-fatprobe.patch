-  //
-  gBS->Stall (3 * 1000 * 1000);
+  if (!EFI_ERROR (Status)) {
+    //
+    // Try when Fat installs its SimpleFileSystem, and retry every two seconds
+    // in case the protocol was installed before this driver ran.
+    //
+    Status = gBS->CreateEvent (
+                    EVT_NOTIFY_SIGNAL,
+                    TPL_CALLBACK,
+                    ProbeFat,
+                    NULL,
+                    &mFatProbeEvent
+                    );
+    if (!EFI_ERROR (Status)) {
+      Status = gBS->RegisterProtocolNotify (
+                      &gEfiSimpleFileSystemProtocolGuid,
+                      mFatProbeEvent,
+                      &mFatProbeRegistration
+                      );
+    }
+
+    DEBUG ((DEBUG_ERROR, "MERLINXMEM: FAT notify %r\n", Status));
+
+    if (!EFI_ERROR (Status)) {
+      Status = gBS->CreateEvent (
+                      EVT_TIMER,
+                      TPL_CALLBACK,
+                      ProbeFat,
+                      NULL,
+                      &mFatProbeTimer
+                      );
+      if (!EFI_ERROR (Status)) {
+        Status = gBS->SetTimer (mFatProbeTimer, TimerPeriodic, 20 * 1000 * 1000);
+      }
+    }
+
+    DEBUG ((DEBUG_ERROR, "MERLINXMEM: FAT timer %r\n", Status));
+  }
 #endif
 
   return EFI_SUCCESS;
