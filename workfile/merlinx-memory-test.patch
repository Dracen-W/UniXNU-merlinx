+  { 0x07AC00000, 0x0021B0000, "mid-7a" },
+  { 0x07FE00000, 0x000100000, "mid-7fe" },
+  { 0x080000000, 0x00F000000, "high-80" },
+  { 0x08FD00000, 0x00F6F0000, "high-8fd" },
