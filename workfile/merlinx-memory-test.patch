+STATIC
+VOID
+AddAvailableMemory (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINTN       Index;
+
+  for (Index = 0; Index < ARRAY_SIZE (mAvailableMemory); Index++) {
+    Status = gDS->AddMemorySpace (
+                    EfiGcdMemoryTypeSystemMemory,
+                    mAvailableMemory[Index].Base,
+                    mAvailableMemory[Index].Length,
+                    EFI_MEMORY_UC | EFI_MEMORY_WC | EFI_MEMORY_WT | EFI_MEMORY_WB
+                    );
+    if (!EFI_ERROR (Status)) {
+      Status = gDS->SetMemorySpaceAttributes (
+                      mAvailableMemory[Index].Base,
+                      mAvailableMemory[Index].Length,
+                      EFI_MEMORY_WB
+                      );
+      if (EFI_ERROR (Status)) {
+        gDS->RemoveMemorySpace (mAvailableMemory[Index].Base, mAvailableMemory[Index].Length);
+      }
+    }
+
+    DEBUG ((
+      DEBUG_ERROR,
+      "MERLINXMEM: RAM %a 0x%lx-0x%lx %r\n",
+      mAvailableMemory[Index].Name,
+      mAvailableMemory[Index].Base,
+      mAvailableMemory[Index].Base + mAvailableMemory[Index].Length - 1,
+      Status
+      ));
+  }
+}
+
+#ifndef MDEPKG_NDEBUG
+STATIC
+VOID
+TestAvailableMemory (
+  VOID
+  )
+{
+  EFI_STATUS            Status;
+  EFI_PHYSICAL_ADDRESS  Base;
+  UINTN                 Pages;
+  UINTN                 Index;
+  volatile UINT64       *Ptr;
+  BOOLEAN               Failed;
+
+  Base  = 0xC0000000;
+  Pages = EFI_SIZE_TO_PAGES (MEMORY_TEST_SIZE);
+  Status = gBS->AllocatePages (AllocateAddress, EfiBootServicesData, Pages, &Base);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "MERLINXMEM: 256 MiB allocation at 0xC0000000 failed %r\n", Status));
+    return;
+  }
+
+  if (Base != 0xC0000000) {
+    gBS->FreePages (Base, Pages);
+    DEBUG ((DEBUG_ERROR, "MERLINXMEM: 256 MiB allocation moved to 0x%lx\n", Base));
+    return;
+  }
+
+  Ptr = (volatile UINT64 *)(UINTN)Base;
+  for (Index = 0; Index < MEMORY_TEST_SIZE / sizeof (UINT64); Index++) {
+    Ptr[Index] = 0x4D45524C494E58ULL;
+  }
+
+  Failed = FALSE;
+  for (Index = 0; Index < MEMORY_TEST_SIZE / sizeof (UINT64); Index++) {
+    if (Ptr[Index] != 0x4D45524C494E58ULL) {
+      Failed = TRUE;
+      break;
+    }
+  }
+
+  gBS->FreePages (Base, Pages);
+  DEBUG ((DEBUG_ERROR, "MERLINXMEM: 256 MiB test at 0xC0000000 %a\n", Failed ? "FAILED" : "passed"));
+}
+#endif
