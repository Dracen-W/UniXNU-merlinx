+  { 0x0BFE40000, 0x000130000, "high-bfe4" },
+  { 0x0BFFF0000, 0x000010000, "high-bfff" },
+  { 0x0C0000000, 0x03EFF6000, "high-c0" },
+  { 0x100000000, 0x01A000000, "high-4g" },
+};
 
