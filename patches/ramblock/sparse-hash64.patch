+static uint64_t ramSparseSlotCount(uint64_t logicalBytes) {
+  uint64_t pages = logicalBytes / 4096;
+  if (pages >= 131072) return 262144; // 4 MiB table, up to ~1 GiB resident 4K pages across any 64-bit disk size
+  uint64_t cap = 64;
+  while (cap < pages * 2) cap <<= 1;
+  return cap;
