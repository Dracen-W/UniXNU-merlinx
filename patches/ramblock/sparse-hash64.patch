+  static uint64_t hash(uint64_t i) {
+    uint64_t h = (i + 1) * 0x9e3779b97f4a7c15ULL;
+    return h ^ (h >> 32);
+  }
+  uint8_t *find(uint64_t i) const {
+    if (!slots || !capacity) return nullptr;
+    uint64_t mask = capacity - 1, key = i + 1;
+    uint64_t pos = hash(i) & mask;
+    for (uint64_t probe = 0; probe < capacity; ++probe) {
+      uint64_t k = slots[pos].key;
+      if (k == key) return slots[pos].page;
+      if (k == 0) return nullptr;
+      pos = (pos + 1) & mask;
+    }
+    return nullptr;
+  }
+  bool insert(uint64_t i, uint8_t *page) {
+    if (!slots || !capacity || !page) return false;
+    uint64_t mask = capacity - 1, key = i + 1;
+    uint64_t pos = hash(i) & mask;
+    for (uint64_t probe = 0; probe < capacity; ++probe) {
+      uint64_t k = slots[pos].key;
+      if (k == 0 || k == key) {
+        slots[pos].key = key;
+        slots[pos].page = page;
+        return true;
+      }
+      pos = (pos + 1) & mask;
+    }
+    return false;
+  }
