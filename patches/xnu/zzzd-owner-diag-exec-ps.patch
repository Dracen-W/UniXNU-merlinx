+/* An unresolved user fault is about to become a signal. Record the pid, the PC and LR in shared-cache coordinates and the fault
+ * address + x0/x1 registers, throttled per process so a crash loop (lsd) does not evict earlier boot events from the ring. */
+static void
+native_diag_user_fault(arm_saved_state_t *state, vm_offset_t fault_addr)
+{
+	extern int proc_getpid(proc_t);
+	extern char *proc_best_name(proc_t);
+	extern boolean_t native_diag_should_print_fault(const char *name);
+	extern void native_gop_text(unsigned line, const char *text);
+	proc_t p = current_proc();
+	char *nm = p ? proc_best_name(p) : "?";
+	if (!native_diag_should_print_fault(nm))
+		return;
+	task_t task = current_task();
+	vm_map_t map = task ? get_task_map(task) : VM_MAP_NULL;
+	uint64_t slide = (task && task->shared_region) ? task->shared_region->sr_slide : 0;
+	uint64_t pc = get_saved_state_pc(state), lr = get_saved_state_lr(state);
+	uint64_t fp = saved_state64(state)->fp, sp = saved_state64(state)->sp;
+	uint64_t x0 = saved_state64(state)->x[0], x1 = saved_state64(state)->x[1];
+	uint64_t uframes[6] = {0, 0, 0, 0, 0, 0}, objw[2] = {0, 0};
+	char line[48];
+	if (pc >= 0x180000000ULL && pc >= slide)
+		pc -= slide;
+	if (lr >= 0x180000000ULL && lr >= slide)
+		lr -= slide;
+	snprintf(line, sizeof(line), "UG %d %.8s %llx %llx", proc_getpid(p), nm,
+	    (unsigned long long)pc, (unsigned long long)lr);
+	native_gop_text(100, line);
+	snprintf(line, sizeof(line), "UF %llx x0:%llx x1:%llx", (unsigned long long)fault_addr,
+	    (unsigned long long)x0, (unsigned long long)x1);
+	native_gop_text(100, line);
+	if (map && x0 > 0x1000ULL && (x0 & 7ULL) == 0 &&
+	    vm_map_read_user(map, x0, objw, sizeof(objw)) == KERN_SUCCESS) {
+		snprintf(line, sizeof(line), "UO %llx %llx",
+		    (unsigned long long)objw[0], (unsigned long long)objw[1]);
+		native_gop_text(100, line);
+	}
+	if (map && fp) {
+		unsigned int d;
+		for (d = 0; d < 6 && fp > sp && (fp & 7ULL) == 0; d++) {
+			uint64_t pair[2] = {0, 0};
+			if (vm_map_read_user(map, fp, pair, sizeof(pair)) != KERN_SUCCESS)
+				break;
+			uframes[d] = (pair[1] >= 0x180000000ULL && pair[1] >= slide) ? pair[1] - slide : pair[1];
+			if (pair[0] <= fp || pair[0] - fp > 0x100000ULL)
+				break;
+			fp = pair[0];
+		}
+		snprintf(line, sizeof(line), "U1 %llx %llx",
+		    (unsigned long long)uframes[0], (unsigned long long)uframes[1]);
+		native_gop_text(100, line);
+		if (uframes[2] || uframes[3]) {
+			snprintf(line, sizeof(line), "U2 %llx %llx",
+			    (unsigned long long)uframes[2], (unsigned long long)uframes[3]);
+			native_gop_text(100, line);
+		}
+		if (uframes[4] || uframes[5]) {
+			snprintf(line, sizeof(line), "U3 %llx %llx",
+			    (unsigned long long)uframes[4], (unsigned long long)uframes[5]);
+			native_gop_text(100, line);
+		}
+	}
+}
