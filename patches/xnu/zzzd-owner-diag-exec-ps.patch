+
+/* Live pids of the services on the path to the first frame, so one photo answers whether the UI stack exists: sb SpringBoard,
+ * bb backboardd, fb frontboardd, rb runningboardd, ls lsd, cm containermanagerd. Entries clear on exit. */
+static const char *const native_diag_tracked[] = {
+	"backboardd", "SpringBoard", "frontboardd", "runningboardd",
+	"lsd", "containermanager", "cfprefsd", "distnoted",
+};
+static int native_diag_tracked_pid[8];
+
+static int
+native_diag_tracked_slot(const char *name)
+{
+	unsigned int i;
+	if (!name)
+		return -1;
+	for (i = 0; i < sizeof(native_diag_tracked) / sizeof(native_diag_tracked[0]); i++)
+		if (strcmp(name, native_diag_tracked[i]) == 0)
+			return (int)i;
+	return -1;
+}
+
+static void
+native_diag_process_summary(void)
+{
+	char summary[48];
+	snprintf(summary, sizeof(summary), "PS sb%d bb%d fb%d rb%d ls%d cm%d",
+	    native_diag_tracked_pid[1], native_diag_tracked_pid[0], native_diag_tracked_pid[2],
+	    native_diag_tracked_pid[3], native_diag_tracked_pid[4], native_diag_tracked_pid[5]);
+	native_gop_text(100, summary);
+}
+
+void
+native_diag_note_exec(int pid, const char *name)
+{
+	int slot = native_diag_tracked_slot(name);
+	if (slot >= 0)
+		native_diag_tracked_pid[slot] = pid;
+	native_diag_process_summary();
+}
+
+void
+native_diag_note_exit(int pid, const char *name)
+{
+	int slot = native_diag_tracked_slot(name);
+	if (slot >= 0 && native_diag_tracked_pid[slot] == pid)
+		native_diag_tracked_pid[slot] = 0;
+	native_diag_process_summary();
+}
