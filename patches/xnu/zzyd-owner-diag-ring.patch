 	proc_unlock(p);
 
+	if (p->p_pid > 1) {
+		extern void native_gop_text(unsigned line, const char *text);
+		const char *nm = p->p_name[0] ? p->p_name : p->p_comm;
+		char ex_text[48];
+		if (exit_reason != OS_REASON_NULL) {
+			snprintf(ex_text, sizeof(ex_text), "EX %d %.12s %x R%u:%llx",
+			    p->p_pid, nm, rv, exit_reason->osr_namespace,
+			    (unsigned long long)exit_reason->osr_code);
+			native_gop_text(20, ex_text);
+		} else {
+			snprintf(ex_text, sizeof(ex_text), "EX %d %.16s %x",
+			    p->p_pid, nm, rv);
+		}
+		native_gop_text(100, ex_text);
+	}
+
 	proc_prepareexit(p, rv, perf_notify);
 
 	/* Last thread to terminate will call proc_exit() */
