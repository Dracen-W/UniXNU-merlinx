diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index db37bf3..202da6a 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1625,6 +1625,22 @@ exit_with_reason(proc_t p, int rv, int *retval, boolean_t thread_can_terminate,
