+static char *
+native_musb_strstr(const char *haystack, const char *needle)
+{
+	const char *h = haystack;
+	size_t nlen = 0;
+
+	if (!haystack || !needle)
+		return NULL;
+	while (needle[nlen])
+		nlen++;
+	if (nlen == 0)
+		return (char *)haystack;
+	for (; *h; h++) {
+		size_t i = 0;
+		while (i < nlen && h[i] == needle[i])
+			i++;
+		if (i == nlen)
+			return (char *)h;
+	}
+	return NULL;
+}
