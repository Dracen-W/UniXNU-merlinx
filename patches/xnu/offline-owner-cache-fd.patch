diff --git a/bsd/kern/sys_generic.c b/bsd/kern/sys_generic.c
index f229fc1..b90a74c 100644
--- a/bsd/kern/sys_generic.c
+++ b/bsd/kern/sys_generic.c
@@ -392,14 +392,55 @@ read(struct proc *p, struct read_args *uap, user_ssize_t *retval)
 	return read_nocancel(p, (struct read_nocancel_args *)uap, retval);
 }
 
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+extern volatile int native_owner_cache_last_fd;
+extern volatile int native_owner_cache_pread_calls;
+extern volatile int native_owner_cache_pread_last_error;
+extern volatile int native_owner_cache_pread_first_valid;
+extern char native_owner_cache_pread_first_hex[17];
+extern volatile unsigned int native_owner_cache_hdr_mapping_offset;
+extern volatile unsigned int native_owner_cache_hdr_mapping_count;
+extern volatile unsigned long long native_owner_cache_hdr_cs_offset;
+extern volatile unsigned long long native_owner_cache_hdr_cs_size;
+extern volatile unsigned int native_owner_cache_hdr_platform;
+extern volatile unsigned long long native_owner_cache_hdr_map_file_offset;
+extern volatile unsigned int native_owner_cache_hdr_map_max_prot;
+#endif
+
 int
 pread_nocancel(struct proc *p, struct pread_nocancel_args *uap, user_ssize_t *retval)
 {
 	KERNEL_DEBUG_CONSTANT((BSDDBG_CODE(DBG_BSD_SC_EXTENDED_INFO, SYS_pread) | DBG_FUNC_NONE),
 	    uap->fd, uap->nbyte, (unsigned int)((uap->offset >> 32)), (unsigned int)(uap->offset), 0);
 
-	return read_internal(p, uap->fd, uap->buf, uap->nbyte, uap->offset,
+	int error = read_internal(p, uap->fd, uap->buf, uap->nbyte, uap->offset,
 	           FOF_OFFSET, retval);
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+	if (uap->fd == native_owner_cache_last_fd) {
+		__atomic_fetch_add(&native_owner_cache_pread_calls, 1, __ATOMIC_RELAXED);
+		native_owner_cache_pread_last_error = error;
+		if (error == 0 && uap->offset == 0) {
+			unsigned char hdr[0x600] = {};
+			if (copyin(uap->buf, hdr, sizeof(hdr)) == 0) {
+				snprintf(native_owner_cache_pread_first_hex, sizeof(native_owner_cache_pread_first_hex),
+				    "%02x%02x%02x%02x%02x%02x%02x%02x",
+				    hdr[0], hdr[1], hdr[2], hdr[3], hdr[4], hdr[5], hdr[6], hdr[7]);
+				memcpy((void *)&native_owner_cache_hdr_mapping_offset, hdr + 0x10, 4);
+				memcpy((void *)&native_owner_cache_hdr_mapping_count, hdr + 0x14, 4);
+				memcpy((void *)&native_owner_cache_hdr_cs_offset, hdr + 0x28, 8);
+				memcpy((void *)&native_owner_cache_hdr_cs_size, hdr + 0x30, 8);
+				memcpy((void *)&native_owner_cache_hdr_platform, hdr + 0x68, 4);
+				unsigned int mo = native_owner_cache_hdr_mapping_offset;
+				if (mo + 32 <= sizeof(hdr)) {
+					memcpy((void *)&native_owner_cache_hdr_map_file_offset, hdr + mo + 16, 8);
+					memcpy((void *)&native_owner_cache_hdr_map_max_prot, hdr + mo + 24, 4);
+				}
+				native_owner_cache_pread_first_valid = 1;
+			}
+		}
+	}
+#endif
+	return error;
 }
 
