+static void
+native_gop_update_progress(unsigned line)
+{
+	if (&native_legacy_retired_frames != NULL && native_legacy_retired_frames >= 6)
+		return;
+	if (!vinfo.v_baseaddr || vinfo.v_depth != 32 || vinfo.v_width < 512 || vinfo.v_height < 600)
+		return;
+
+	unsigned int pct = native_gop_boot_pct;
+	unsigned int seq = __atomic_load_n(&native_diag_seq, __ATOMIC_RELAXED);
+	if (line == 0 && pct < 6)
+		pct = 6;
+	else if (line == 1 && pct < 12)
+		pct = 12;
+	else if ((line == 2 || line == 3) && pct < 18)
+		pct = 18;
+	else if (line == 7 && pct < 22)
+		pct = 22;
+	else if (line == 4 && pct < 26)
+		pct = 26;
+	if (seq > 0) {
+		unsigned int seq_pct = 26U + (seq * 62U) / 110U;
+		if (seq_pct > 88U)
+			seq_pct = 88U;
+		if (seq_pct > pct)
+			pct = seq_pct;
+	}
+	if (line == 24 && pct < 90U)
+		pct = 90U;
+	if (line == 28 && pct < 93U)
+		pct = 93U;
+	if (&native_legacy_retired_frames != NULL && native_legacy_retired_frames > 0) {
+		unsigned int f_pct = 94U + native_legacy_retired_frames;
+		if (f_pct > 100U)
+			f_pct = 100U;
+		if (f_pct > pct)
+			pct = f_pct;
+	}
+	if (pct == native_gop_boot_pct && line >= 100 && (seq & 3U) != 0)
+		return;
+	native_gop_boot_pct = pct;
+
+	volatile uint32_t *fb = (volatile uint32_t *)(uintptr_t)vinfo.v_baseaddr;
+	uint32_t stride = vinfo.v_rowbytes / 4;
+	uint32_t bar_x0 = 220, bar_x1 = vinfo.v_width - 32;
+	uint32_t bar_y0 = 272, bar_y1 = 300;
+	if (bar_x1 <= bar_x0 + 16 || bar_y1 >= vinfo.v_height)
+		return;
+	uint32_t fill_w = ((bar_x1 - bar_x0 - 4) * pct) / 100U;
+	for (uint32_t py = bar_y0; py < bar_y1; py++) {
+		boolean_t border_y = (py < bar_y0 + 2 || py >= bar_y1 - 2);
+		for (uint32_t px = bar_x0; px < bar_x1; px++) {
+			boolean_t border_x = (px < bar_x0 + 2 || px >= bar_x1 - 2);
+			uint32_t color = (border_x || border_y) ? 0xffffffffu :
+			    ((px < bar_x0 + 2 + fill_w) ? 0xff00e676u : 0xff222222u);
+			fb[(uint64_t)py * stride + px] = color;
+		}
+	}
+	char pct_label[24];
+	snprintf(pct_label, sizeof(pct_label), "BOOT %3u%%", pct);
+	native_gop_draw_span(16, bar_x0 - 8, 274, 2, 0xff00e676u, pct_label);
+}
+
 extern void native_musb_log_gop(unsigned line, const char *text);
 void
 native_gop_text(unsigned line, const char *text)
 {
 	if (text)
 		native_musb_log_gop(line, text);
+	native_gop_update_progress(line);
 	if (!vinfo.v_baseaddr || vinfo.v_depth != 32 || vinfo.v_width < 512 || vinfo.v_height < 600 || !text)
 		return;
