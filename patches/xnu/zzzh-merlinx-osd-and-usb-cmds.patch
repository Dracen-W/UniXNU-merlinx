+static uint32_t
+native_musb_parse_u32(const char **p)
+{
+	const char *s = *p;
+	uint32_t v = 0;
+	while (*s == ' ' || *s == '\t')
+		s++;
+	while (*s >= '0' && *s <= '9') {
+		v = v * 10u + (uint32_t)(*s - '0');
+		s++;
+	}
+	*p = s;
+	return v;
+}
+
+static int32_t
+native_musb_parse_i32(const char **p)
+{
+	const char *s = *p;
+	int32_t sign = 1;
+	while (*s == ' ' || *s == '\t')
+		s++;
+	if (*s == '-') {
+		sign = -1;
+		s++;
+	} else if (*s == '+') {
+		s++;
+	}
+	*p = s;
+	return sign * (int32_t)native_musb_parse_u32(p);
+}
