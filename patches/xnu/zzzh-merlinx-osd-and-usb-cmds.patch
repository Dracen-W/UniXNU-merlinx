+			if (ss && bp_map && ss->fp > ss->sp && (ss->fp & 7ULL) == 0 &&
+			    (ss->fp - ss->sp) <= 0x40000ULL) {
+				for (unsigned int uw = 0; uw < 4; uw++) {
+					uint64_t fpair[2] = {0, 0};
+					if (vm_map_read_user(bp_map, ss->fp, fpair, sizeof(fpair)) != KERN_SUCCESS)
+						break;
+					uint64_t ret_pc = fpair[1] & 0x0000007fffffffffULL;
+					if (ret_pc < 0x100000000ULL)
+						break;
+					if (ss->pc >= 0x100000000ULL) {
+						for (unsigned int back = 1; back <= 512; back++) {
+							uint64_t addr = ss->pc - (uint64_t)back * 4ULL;
+							uint32_t insn = 0, prev = 0;
+							if (vm_map_read_user(bp_map, addr, &insn, sizeof(insn)) != KERN_SUCCESS)
+								break;
+							if ((insn & 0xffc003ffU) != 0x910003fdU)
+								continue;
+							uint32_t fp_off = (insn >> 10) & 0xfffU;
+							if (fp_off > (ss->fp - ss->sp))
+								continue;
+							if (vm_map_read_user(bp_map, addr - 4ULL, &prev, sizeof(prev)) != KERN_SUCCESS)
+								break;
+							if ((prev & 0x7fffU) != 0x7bfdU)
+								continue;
+							uint64_t sp_base = ss->fp - (uint64_t)fp_off;
+							for (unsigned int k = 2; k <= 8; k++) {
+								uint32_t stp = 0;
+								if (vm_map_read_user(bp_map, addr - (uint64_t)k * 4ULL, &stp, sizeof(stp)) != KERN_SUCCESS)
+									break;
+								if (((stp & 0xffc003e0U) == 0xa90003e0U) ||
+								    ((stp & 0xffc003e0U) == 0xa98003e0U)) {
+									unsigned int rt1 = stp & 0x1fU;
+									unsigned int rt2 = (stp >> 10) & 0x1fU;
+									int32_t imm7 = (int32_t)((stp >> 15) & 0x7fU);
+									if (imm7 & 0x40)
+										imm7 -= 0x80;
+									int64_t off_b = ((stp & 0xffc003e0U) == 0xa98003e0U) ? 0LL : (int64_t)imm7 * 8LL;
+									uint64_t sv[2] = {0, 0};
+									if (vm_map_read_user(bp_map, (uint64_t)((int64_t)sp_base + off_b), sv, sizeof(sv)) == KERN_SUCCESS) {
+										if (rt1 >= 19 && rt1 <= 28)
+											ss->x[rt1] = sv[0];
+										if (rt2 >= 19 && rt2 <= 28)
+											ss->x[rt2] = sv[1];
+									}
+								}
+							}
+							break;
+						}
+					}
+					ss->sp = ss->fp + 16ULL;
+					ss->fp = fpair[0];
+					ss->lr = ret_pc;
+					ss->pc = ret_pc;
+					ss->x[0] = 0;
+					uint64_t slide = (bp_task && bp_task->shared_region) ? bp_task->shared_region->sr_slide : 0;
+					uint64_t ret_u = (ret_pc >= 0x180000000ULL && ret_pc >= slide) ? (ret_pc - slide) : ret_pc;
+					if ((ret_u >= 0x18f580000ULL && ret_u < 0x18f5d0000ULL) ||
+					    ss->fp <= ss->sp || (ss->fp - ss->sp) > 0x40000ULL)
+						break;
+				}
+				return;
+			} else if (ss && ss->lr != ss->pc && ss->lr >= 0x100000000ULL) {
+				ss->x[0] = 0;
+				ss->pc = ss->lr;
+				return;
+			}
+		}
+	}
