+		"assertiond", "sysstatus", "keybagd", "lockdownd",
+		"fairplayd", "cryptexd", "amfid", "trustd",
+		"securityd", "UserEventAgent", "notifyd", "logd",
+		"dasd", "hangtracerd", "ReportCrash", "MTLCompiler",
+		"ScreenTime", "frontboardd",
+	};
+	unsigned int i;
+	if (!name || !name[0])
+		return FALSE;
+	for (i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++) {
+		size_t len = strlen(prefixes[i]);
+		if (strncmp(name, prefixes[i], len) == 0)
