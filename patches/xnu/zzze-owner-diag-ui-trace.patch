+const char *
+native_diag_xp_lookup(int pid)
+{
+	if (pid <= 1)
+		return NULL;
+	unsigned int slot = (unsigned int)pid & 255U;
+	if (native_diag_xp_table[slot].pid == pid && native_diag_xp_table[slot].tag[0])
+		return native_diag_xp_table[slot].tag;
+	return NULL;
+}
