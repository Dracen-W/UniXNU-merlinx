+static boolean_t
+native_diag_focus_same(const char *a, const char *b)
+{
+	unsigned int i = 0;
+	if (!a || !b)
+		return FALSE;
+	while (i < 16 && a[i] && a[i] == b[i]) {
+		i++;
+	}
+	if (i == 16)
+		return TRUE;
+	return a[i] == b[i];
+}
+
+static char native_diag_focus[4][17];
+static int native_diag_focus_pid[4];
+static int native_diag_focus_pid2[4];
