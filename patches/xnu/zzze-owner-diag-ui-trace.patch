+void
+native_diag_xp_note(int pid, const char *tag)
+{
+	if (pid <= 1 || !tag || !tag[0])
+		return;
+	if (strncmp(tag, "com.apple.", 10) == 0)
+		tag += 10;
+	unsigned int slot = (unsigned int)pid & 255U;
+	native_diag_xp_table[slot].pid = pid;
+	strlcpy(native_diag_xp_table[slot].tag, tag, sizeof(native_diag_xp_table[slot].tag));
+}
