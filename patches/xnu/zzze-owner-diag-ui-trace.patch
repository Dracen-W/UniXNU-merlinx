index 31bad41..d0e815e 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -62,6 +62,10 @@
 #include <vm/vm_fault.h>
 #include <vm/vm_kern.h>
 #include <vm/vm_shared_region.h>
+#include <kern/clock.h>
