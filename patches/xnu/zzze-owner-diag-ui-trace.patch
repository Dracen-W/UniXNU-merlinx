+		native_gop_text(25, line);
+	} else {
+		snprintf(line, sizeof(line), "%c%d x16:%lld f1:%llx f2:%llx", role, pid,
+		    (long long)state.x[16], (unsigned long long)frames[0], (unsigned long long)frames[1]);
+		native_gop_text(22, line);
+		snprintf(line, sizeof(line), "%c%d f3:%llx f4:%llx", role, pid,
+		    (unsigned long long)frames[2], (unsigned long long)frames[3]);
+		native_gop_text(23, line);
+		snprintf(line, sizeof(line), "%c%d f5:%llx f6:%llx", role, pid,
+		    (unsigned long long)frames[4], (unsigned long long)frames[5]);
+		native_gop_text(24, line);
+		snprintf(line, sizeof(line), "%c%d f7:%llx f8:%llx", role, pid,
+		    (unsigned long long)frames[6], (unsigned long long)frames[7]);
+		native_gop_text(25, line);
+	}
+release_thread:
+	thread_deallocate(thread);
+release_proc:
+	proc_rele(p);
+reschedule:
+	native_diag_process_summary();
+	native_gop_redraw_ring();
+	clock_interval_to_deadline(4, (uint32_t)NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(native_diag_focus_call, deadline);
+}
+
+void
+native_diag_focus_start(void)
+{
+	unsigned int i;
+	if (native_diag_focus_call)
+		return;
+	if (!native_diag_focus_configured)
+		native_diag_focus_configure();
+	for (i = 0; i < 4; i++)
+		if (native_diag_focus[i][0] && native_diag_focus_pid[i] > 0)
+			break;
+	if (i == 4)
+		return;
+	native_diag_focus_call = thread_call_allocate(native_diag_focus_sample, NULL);
+	if (native_diag_focus_call) {
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(4, (uint32_t)NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(native_diag_focus_call, deadline);
+	}
+}
+
+void
+native_diag_focus_note(int pid, const char *name)
+{
+	unsigned int i;
+	if (!native_diag_focus_configured)
+		native_diag_focus_configure();
+	for (i = 0; i < 4; i++)
+		if (native_diag_focus[i][0] && native_diag_focus_same(native_diag_focus[i], name))
+			native_diag_focus_pid[i] = pid;
+}
+
+void
+native_diag_focus_exit(int pid)
+{
+	unsigned int i;
+	for (i = 0; i < 4; i++)
+		if (native_diag_focus_pid[i] == pid)
+			native_diag_focus_pid[i] = 0;
+}
