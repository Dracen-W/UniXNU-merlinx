+		"dasd", "hangtracerd", "ReportCrash", "MTLCompiler",
+		"ScreenTime", "frontboardd", "iconservices", "datamigrator",
+		"migrationplugin", "Setup", "pkd", "duetexpertd", "thermalmonitor",
+		"installcoord", "installd", "misagent", "online-auth", "mobileactivat",
+		"appstored", "MobileStorage", "diskimages", "storagekitd", "purplebuddy",
+	};
+	unsigned int i;
+	if (!name || !name[0])
+		return FALSE;
+	for (i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++) {
+		size_t len = strlen(prefixes[i]);
+		if (strncmp(name, prefixes[i], len) == 0)
