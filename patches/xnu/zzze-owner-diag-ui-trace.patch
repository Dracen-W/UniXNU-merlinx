+static unsigned int
+native_diag_bump_count(struct native_diag_throttle *table, const char *name)
+{
+	unsigned int i, free_slot = NATIVE_DIAG_THROTTLE_SLOTS;
+	if (!name || !name[0])
+		return 1;
+	for (i = 0; i < NATIVE_DIAG_THROTTLE_SLOTS; i++) {
+		if (!table[i].name[0]) {
+			if (free_slot == NATIVE_DIAG_THROTTLE_SLOTS)
+				free_slot = i;
+			continue;
+		}
+		if (strncmp(table[i].name, name, sizeof(table[i].name) - 1) == 0) {
+			table[i].count++;
+			return table[i].count;
+		}
+	}
+	if (free_slot == NATIVE_DIAG_THROTTLE_SLOTS)
+		return 1;
+	strlcpy(table[free_slot].name, name, sizeof(table[free_slot].name));
+	table[free_slot].count = 1;
+	return 1;
+}
+
+static boolean_t
+native_diag_throttle(struct native_diag_throttle *table, const char *name)
+{
+	unsigned int count = native_diag_bump_count(table, name);
+	return count <= 3 || (count & 63U) == 0;
+}
