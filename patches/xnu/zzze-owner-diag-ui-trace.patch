+static void
+native_musb_exec_command(const char *cmd)
+{
+	while (*cmd == ' ' || *cmd == '\t')
+		cmd++;
+	merlinx_cmd_out_len = 0;
+	merlinx_cmd_out[0] = 0;
+	native_musb_log_printf("[USB-CMD] > %s\n", cmd);
+
+	if (strncmp(cmd, "help", 4) == 0 || cmd[0] == 0) {
+		native_musb_cmd_append(
+		    "Merlinx Mode A MUSB EP0 Live Commands:\n"
+		    "  help              Show this help\n"
+		    "  ps                List all active processes (PID, comm, xpc tag, threads)\n"
+		    "  bt <pid|name>     Dump userland stack frames (f1..f12) & regs for PID or daemon name\n"
+		    "  allbt             Dump userland stack frames for all key UI/system daemons\n"
+		    "  ring              Dump the 64-slot screen event ring + PS summary\n"
+		    "  kill <pid> [sig]  Send signal (default 9=SIGKILL) to PID\n"
+		    "  icblock <0|1>     Set iconservicesagent spawn block (currently %u)\n"
+		    "  musb              Dump MUSB + U2PHY hardware register state\n",
+		    native_diag_block_iconservices);
+	} else if (strncmp(cmd, "ps", 2) == 0) {
+		native_musb_cmd_append("PID   THR  NAME                 XPC_TAG\n");
+		for (int pid = 1; pid < 512; pid++) {
+			proc_t p = proc_find(pid);
+			if (!p)
+				continue;
+			const char *nm = p->p_name[0] ? p->p_name : p->p_comm;
+			const char *xtag = native_diag_xp_lookup(pid);
+			task_t task = proc_task(p);
+			unsigned int nth = 0;
+			if (task) {
+				thread_t th = THREAD_NULL;
+				task_lock(task);
+				queue_iterate(&task->threads, th, thread_t, task_threads) {
+					nth++;
+				}
+				task_unlock(task);
+			}
+			native_musb_cmd_append("%-5d %-4u %-20s %s\n",
+			    pid, nth, nm, xtag ? xtag : "-");
+			proc_rele(p);
+		}
+	} else if (strncmp(cmd, "allbt", 5) == 0) {
+		for (int pid = 1; pid < 400; pid++) {
+			proc_t p = proc_find(pid);
+			if (!p)
+				continue;
+			native_musb_dump_proc_bt(p, TRUE);
+			proc_rele(p);
+		}
+	} else if (strncmp(cmd, "bt", 2) == 0) {
+		const char *arg = cmd + 2;
+		while (*arg == ' ' || *arg == '\t')
+			arg++;
+		int target_pid = 0;
+		if (*arg >= '0' && *arg <= '9') {
+			while (*arg >= '0' && *arg <= '9') {
+				target_pid = target_pid * 10 + (*arg - '0');
+				arg++;
+			}
+			proc_t p = proc_find(target_pid);
+			if (p) {
+				native_musb_dump_proc_bt(p, TRUE);
+				proc_rele(p);
+			} else {
+				native_musb_cmd_append("PID %d not found\n", target_pid);
+			}
+		} else if (*arg) {
+			unsigned int matches = 0;
+			for (int pid = 1; pid < 512; pid++) {
+				proc_t p = proc_find(pid);
+				if (!p)
+					continue;
+				const char *nm = p->p_name[0] ? p->p_name : p->p_comm;
+				const char *xtag = native_diag_xp_lookup(pid);
+				if (strstr(nm, arg) || (xtag && strstr(xtag, arg))) {
+					native_musb_dump_proc_bt(p, TRUE);
+					matches++;
+				}
+				proc_rele(p);
+			}
+			if (matches == 0)
+				native_musb_cmd_append("No process matching '%s'\n", arg);
+		} else {
+			native_musb_cmd_append("Usage: bt <pid|name>\n");
+		}
+	} else if (strncmp(cmd, "kill", 4) == 0) {
+		const char *arg = cmd + 4;
+		while (*arg == ' ' || *arg == '\t')
+			arg++;
+		int target_pid = 0, sig = 9;
+		while (*arg >= '0' && *arg <= '9') {
+			target_pid = target_pid * 10 + (*arg - '0');
+			arg++;
+		}
+		while (*arg == ' ' || *arg == '\t')
+			arg++;
+		if (*arg >= '0' && *arg <= '9') {
+			sig = 0;
+			while (*arg >= '0' && *arg <= '9') {
+				sig = sig * 10 + (*arg - '0');
+				arg++;
+			}
+		}
+		if (target_pid > 1) {
+			proc_t p = proc_find(target_pid);
+			if (p) {
+				psignal(p, sig);
+				proc_rele(p);
+				native_musb_cmd_append("Sent signal %d to PID %d\n", sig, target_pid);
+				native_musb_log_printf("[USB-CMD] Sent signal %d to PID %d\n", sig, target_pid);
+			} else {
+				native_musb_cmd_append("PID %d not found\n", target_pid);
+			}
+		} else {
+			native_musb_cmd_append("Usage: kill <pid> [sig]\n");
+		}
+	} else if (strncmp(cmd, "icblock", 7) == 0) {
+		const char *arg = cmd + 7;
+		while (*arg == ' ' || *arg == '\t')
+			arg++;
+		if (*arg == '0')
+			native_diag_block_iconservices = 0;
+		else if (*arg == '1')
+			native_diag_block_iconservices = 1;
+		native_musb_cmd_append("native_diag_block_iconservices = %u\n", native_diag_block_iconservices);
+		native_musb_log_printf("[USB-CMD] native_diag_block_iconservices = %u\n", native_diag_block_iconservices);
+	} else if (strncmp(cmd, "ring", 4) == 0) {
+		native_musb_cmd_append("write_seq=%llu polls=%u resets=%u setups=%u\n",
+		    (unsigned long long)merlinx_log_write_seq,
+		    merlinx_usb_polls, merlinx_usb_resets, merlinx_usb_setups);
+	} else if (strncmp(cmd, "musb", 4) == 0 && merlinx_musb_base && merlinx_u2phy_base) {
+		musb_write8(MUSB_INDEX, 0);
+		uint8_t faddr = musb_read8(MUSB_FADDR);
+		uint8_t power = musb_read8(MUSB_POWER);
+		uint8_t devctl = musb_read8(MUSB_DEVCTL);
+		uint16_t csr0 = musb_read16(MUSB_CSR0);
+		uint32_t u2p_68 = *(volatile uint32_t *)(merlinx_u2phy_base + 0x68U);
+		uint32_t u2p_6c = *(volatile uint32_t *)(merlinx_u2phy_base + 0x6CU);
+		uint32_t u2p_1c = *(volatile uint32_t *)(merlinx_u2phy_base + 0x1CU);
+		native_musb_cmd_append(
+		    "MUSB: FADDR=0x%02x POWER=0x%02x DEVCTL=0x%02x CSR0=0x%04x\n"
+		    "U2PHY: 0x1c=0x%08x 0x68=0x%08x 0x6c=0x%08x\n"
+		    "STATS: polls=%u resets=%u setups=%u cfg=%u\n",
+		    faddr, power, devctl, csr0, u2p_1c, u2p_68, u2p_6c,
+		    merlinx_usb_polls, merlinx_usb_resets, merlinx_usb_setups, merlinx_usb_config);
+	} else {
+		native_musb_cmd_append("Unknown command '%s' (try 'help')\n", cmd);
+	}
+	merlinx_cmd_seq++;
+}
+
+static void
+native_musb_phy_and_clk_init(void)
+{
+	if (merlinx_pwrap_base) {
+		volatile uint32_t *wacs2_cmd = (volatile uint32_t *)(merlinx_pwrap_base + 0xC20U);
+		volatile uint32_t *wacs2_rdata = (volatile uint32_t *)(merlinx_pwrap_base + 0xC24U);
+		for (unsigned int tries = 0; tries < 2000; tries++) {
+			if (((*wacs2_rdata >> 16) & 0x7U) == 0) {
+				*wacs2_cmd = (1U << 31) | ((0x1b30U >> 1) << 16) | 0x0001U;
+				__builtin_arm_dmb(0xf);
+				break;
+			}
+		}
+	}
+	if (merlinx_topck_base) {
+		*(volatile uint32_t *)(merlinx_topck_base + 0x098U) = (1U << 23);
+		__builtin_arm_dmb(0xf);
+		*(volatile uint32_t *)(merlinx_topck_base + 0x004U) = (1U << 22);
+		__builtin_arm_dmb(0xf);
+		*(volatile uint32_t *)(merlinx_topck_base + 0x104U) |= (1U << 8);
+		__builtin_arm_dmb(0xf);
+	}
+	if (merlinx_infra_base) {
+		*(volatile uint32_t *)(merlinx_infra_base + 0x084U) = (1U << 8);
+		*(volatile uint32_t *)(merlinx_infra_base + 0x08CU) = (1U << 25);
+		*(volatile uint32_t *)(merlinx_infra_base + 0x0A8U) = (1U << 2);
+		*(volatile uint32_t *)(merlinx_infra_base + 0x0C4U) = (1U << 19);
+		__builtin_arm_dmb(0xf);
+	}
+	if (merlinx_pericfg_base) {
+		uint32_t cg = *(volatile uint32_t *)(merlinx_pericfg_base + 0x018U);
+		*(volatile uint32_t *)(merlinx_pericfg_base + 0x018U) = cg & ~((1U << 1) | (1U << 2));
+		__builtin_arm_dmb(0xf);
+	}
+	if (merlinx_u2phy_base) {
+		volatile uint32_t *acr6 = (volatile uint32_t *)(merlinx_u2phy_base + 0x18U);
+		volatile uint32_t *dtm0 = (volatile uint32_t *)(merlinx_u2phy_base + 0x68U);
+		volatile uint32_t *dtm1 = (volatile uint32_t *)(merlinx_u2phy_base + 0x6CU);
+		*acr6 &= ~(1U << 23);
+		__builtin_arm_dmb(0xf);
+		*dtm0 &= ~((1U << 26) | (1U << 23) | (1U << 18) | (1U << 7) | (1U << 6) | (1U << 21) | (1U << 20));
+		*dtm0 |= (1U << 3);
+		__builtin_arm_dmb(0xf);
+		*dtm1 = (*dtm1 & ~0x3FFFU) | 0x3F2EU;
+		__builtin_arm_dmb(0xf);
+	}
+	if (merlinx_musb_base) {
+		musb_write32(0xA4U, 0x00000000U);
+		musb_write16(MUSB_INTRTXE, 0x0000U);
+		musb_write16(MUSB_INTRRXE, 0x0000U);
+		musb_write8(MUSB_INTRUSBE, 0x00U);
+		(void)musb_read16(MUSB_INTRTX);
+		(void)musb_read16(MUSB_INTRRX);
+		(void)musb_read8(MUSB_INTRUSB);
+		musb_write8(MUSB_INDEX, 0);
+		musb_write8(MUSB_FADDR, 0);
+		uint8_t devctl = musb_read8(MUSB_DEVCTL);
+		if (devctl & 0x04U)
+			musb_write8(MUSB_DEVCTL, devctl & ~0x05U);
+		musb_write8(MUSB_POWER, MUSB_POWER_HSENAB | MUSB_POWER_SOFTCONN);
+		musb_write16(MUSB_CSR0, MUSB_CSR0_FLUSHFIFO | MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_SVDSETUPEND);
+	}
+}
