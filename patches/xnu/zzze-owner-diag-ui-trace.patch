+static void
+native_musb_cmd_append(const char *fmt, ...)
+{
+	uint32_t cur = merlinx_cmd_out_len;
+	if (cur >= MERLINX_CMD_OUT_SIZE - 2)
+		return;
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(merlinx_cmd_out + cur, MERLINX_CMD_OUT_SIZE - cur, fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		uint32_t add = (uint32_t)n;
+		if (cur + add >= MERLINX_CMD_OUT_SIZE)
+			merlinx_cmd_out_len = MERLINX_CMD_OUT_SIZE - 1;
+		else
+			merlinx_cmd_out_len = cur + add;
+	}
+}
