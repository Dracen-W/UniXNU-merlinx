+/* One photo answers whether launchd's own root view holds the jobs on the path to the first frame: the five plists and the
+ * five programs, resolved by the kernel after the root union and the Data mount are in place. J and P are in the order
+ * backboardd, SpringBoard, lsd, containermanagerd, runningboardd; 1 = present, 0 = not visible. */
+static void
+native_diag_jobs_probe(void)
+{
+	static const char *const jobs[5] = {
+		"/System/Library/LaunchDaemons/com.apple.backboardd.plist",
+		"/System/Library/LaunchDaemons/com.apple.SpringBoard.plist",
+		"/System/Library/LaunchDaemons/com.apple.lsd.plist",
+		"/System/Library/LaunchDaemons/com.apple.containermanagerd.plist",
+		"/System/Library/LaunchDaemons/com.apple.runningboardd.plist",
+	};
+	static const char *const programs[5] = {
+		"/usr/libexec/backboardd",
+		"/System/Library/CoreServices/SpringBoard.app/SpringBoard",
+		"/usr/libexec/lsd",
+		"/usr/libexec/containermanagerd",
+		"/usr/libexec/runningboardd",
+	};
+	vfs_context_t context = vfs_context_current();
+	char line[8];
+	unsigned int i;
+	line[0] = 'J';
+	line[1] = ' ';
+	for (i = 0; i < 5; i++) {
+		vnode_t node = NULLVP;
+		int error = vnode_lookup(jobs[i], 0, &node, context);
+		line[2 + i] = error ? '0' : '1';
+		if (!error)
+			vnode_put(node);
+	}
+	line[7] = 0;
+	native_gop_text(9, line);
+	line[0] = 'P';
+	for (i = 0; i < 5; i++) {
+		vnode_t node = NULLVP;
+		int error = vnode_lookup(programs[i], 0, &node, context);
+		line[2 + i] = error ? '0' : '1';
+		if (!error)
+			vnode_put(node);
+	}
+	line[7] = 0;
+	native_gop_text(28, line);
 }
