+static const uint8_t merlinx_usb_ms_compat_id[40] = {
+	0x28, 0x00, 0x00, 0x00, 0x00, 0x01, 0x04, 0x00, 0x01,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x01,
+	'W', 'I', 'N', 'U', 'S', 'B', 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00
+};
+
+static uint32_t
+native_musb_make_ascii_str_desc(const char *ascii, uint8_t *out, uint32_t max_len)
+{
+	uint32_t n = 0;
+	while (ascii[n] && (2U + (n + 1U) * 2U) <= max_len && n < 62U)
+		n++;
+	uint32_t total = 2U + n * 2U;
+	out[0] = (uint8_t)total;
+	out[1] = 0x03U;
+	for (uint32_t i = 0; i < n; i++) {
+		out[2U + i * 2U] = (uint8_t)ascii[i];
+		out[3U + i * 2U] = 0;
+	}
+	return total;
+}
+
+static void
+native_musb_ep0_fifo_write(const uint8_t *src, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		*(volatile uint8_t *)(merlinx_musb_base + MUSB_FIFO0) = src[i];
+	}
+	__builtin_arm_dmb(0xf);
+}
+
+static void
+native_musb_ep0_fifo_read(uint8_t *dst, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		dst[i] = *(volatile uint8_t *)(merlinx_musb_base + MUSB_FIFO0);
+	}
+	__builtin_arm_dmb(0xf);
+}
+
+static void
+native_musb_ep0_pump_tx(void)
+{
+	if (!merlinx_ep0_tx_active)
+		return;
+	musb_write8(MUSB_INDEX, 0);
+	uint16_t csr0 = musb_read16(MUSB_CSR0);
+	if (csr0 & MUSB_CSR0_TXPKTRDY)
+		return;
+	uint32_t rem = (merlinx_ep0_tx_len > merlinx_ep0_tx_off) ? (merlinx_ep0_tx_len - merlinx_ep0_tx_off) : 0;
+	uint32_t chunk = (rem > 64U) ? 64U : rem;
+	if (chunk > 0)
+		native_musb_ep0_fifo_write(merlinx_ep0_tx_buf + merlinx_ep0_tx_off, chunk);
+	merlinx_ep0_tx_off += chunk;
+	if (merlinx_ep0_tx_off >= merlinx_ep0_tx_len) {
+		merlinx_ep0_tx_active = FALSE;
+		musb_write16(MUSB_CSR0, MUSB_CSR0_TXPKTRDY | MUSB_CSR0_P_DATAEND);
+	} else {
+		musb_write16(MUSB_CSR0, MUSB_CSR0_TXPKTRDY);
+	}
+}
+
+static void
+native_musb_ep0_start_tx(const void *data, uint32_t len, uint16_t wLength)
+{
+	if (len > wLength)
+		len = wLength;
+	if (len > sizeof(merlinx_ep0_tx_buf))
+		len = sizeof(merlinx_ep0_tx_buf);
+	if (len > 0 && data != merlinx_ep0_tx_buf)
+		memcpy(merlinx_ep0_tx_buf, data, len);
+	merlinx_ep0_tx_len = len;
+	merlinx_ep0_tx_off = 0;
+	merlinx_ep0_tx_active = TRUE;
+	native_musb_ep0_pump_tx();
+}
+
+static void
+native_musb_handle_setup(const uint8_t setup[8])
+{
+	uint8_t bmRequestType = setup[0];
+	uint8_t bRequest = setup[1];
+	uint16_t wValue = (uint16_t)setup[2] | ((uint16_t)setup[3] << 8);
+	uint16_t wIndex = (uint16_t)setup[4] | ((uint16_t)setup[5] << 8);
+	uint16_t wLength = (uint16_t)setup[6] | ((uint16_t)setup[7] << 8);
+
+	merlinx_usb_setups++;
+	merlinx_ep0_tx_active = FALSE;
+	merlinx_ep0_rx_expected = 0;
+
+	if ((bmRequestType & 0x60U) == 0x00U) {
+		switch (bRequest) {
+		case 0x00: {
+			uint8_t status_resp[2] = {0x00, 0x00};
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			native_musb_ep0_start_tx(status_resp, 2, wLength);
+			return;
+		}
+		case 0x01:
+		case 0x03:
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_DATAEND);
+			return;
+		case 0x05:
+			merlinx_usb_pending_addr = (uint8_t)(wValue & 0x7FU);
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_DATAEND);
+			return;
+		case 0x06: {
+			uint8_t dtype = (uint8_t)(wValue >> 8);
+			uint8_t didx = (uint8_t)(wValue & 0xFFU);
+			if (dtype == 0x01U) {
+				musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+				native_musb_ep0_start_tx(merlinx_usb_dev_desc, sizeof(merlinx_usb_dev_desc), wLength);
+				return;
+			} else if (dtype == 0x02U) {
+				musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+				native_musb_ep0_start_tx(merlinx_usb_cfg_desc, sizeof(merlinx_usb_cfg_desc), wLength);
+				return;
+			} else if (dtype == 0x03U) {
+				if (didx == 0) {
+					static const uint8_t lang_desc[4] = {4, 0x03, 0x09, 0x04};
+					musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+					native_musb_ep0_start_tx(lang_desc, sizeof(lang_desc), wLength);
+					return;
+				} else if (didx == 0xEEU) {
+					musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+					native_musb_ep0_start_tx(merlinx_usb_ms_os_str, sizeof(merlinx_usb_ms_os_str), wLength);
+					return;
+				} else {
+					const char *str = "Merlinx XNU";
+					if (didx == 1)
+						str = "UniXNU";
+					else if (didx == 2)
+						str = "Merlinx XNU Diag";
+					else if (didx == 3)
+						str = "MERLINX-MT6768-01";
+					uint32_t slen = native_musb_make_ascii_str_desc(str, merlinx_ep0_tx_buf, 128);
+					musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+					native_musb_ep0_start_tx(merlinx_ep0_tx_buf, slen, wLength);
+					return;
+				}
+			} else if (dtype == 0x06U) {
+				static const uint8_t qual_desc[10] = {10, 0x06, 0x00, 0x02, 0xFF, 0x42, 0x01, 64, 1, 0};
+				musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+				native_musb_ep0_start_tx(qual_desc, sizeof(qual_desc), wLength);
+				return;
+			}
+			break;
+		}
+		case 0x08:
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			native_musb_ep0_start_tx(&merlinx_usb_config, 1, wLength);
+			return;
+		case 0x09:
+			merlinx_usb_config = (uint8_t)(wValue & 0xFFU);
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_DATAEND);
+			return;
+		case 0x0A: {
+			uint8_t alt = 0;
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			native_musb_ep0_start_tx(&alt, 1, wLength);
+			return;
+		}
+		case 0x0B:
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_DATAEND);
+			return;
+		}
+	}
+
+	if ((bmRequestType & 0x60U) == 0x40U) {
+		if (bRequest == 0xA0U && wIndex == 0x0004U) {
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			native_musb_ep0_start_tx(merlinx_usb_ms_compat_id, sizeof(merlinx_usb_ms_compat_id), wLength);
+			return;
+		} else if (bRequest == 0xF0U) {
+			uint64_t ns = 0;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			struct merlinx_usb_status_pkt st = {
+				.magic = 0x4D584C47U,
+				.ring_size = MERLINX_LOG_RING_SIZE,
+				.write_seq = __atomic_load_n(&merlinx_log_write_seq, __ATOMIC_RELAXED),
+				.uptime_cs = ns / 10000000ULL,
+				.usb_polls = merlinx_usb_polls,
+				.usb_resets = merlinx_usb_resets,
+				.usb_setups = merlinx_usb_setups,
+				.cmd_seq = merlinx_cmd_seq,
+				.cmd_len = merlinx_cmd_out_len,
+				.faddr = musb_read8(MUSB_FADDR),
+				.power = musb_read8(MUSB_POWER),
+				.devctl = musb_read8(MUSB_DEVCTL),
+				.config = merlinx_usb_config,
+			};
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			native_musb_ep0_start_tx(&st, sizeof(st), wLength);
+			return;
+		} else if (bRequest == 0xF1U) {
+			uint32_t offset = ((uint32_t)wIndex << 16) | (uint32_t)wValue;
+			uint32_t count = (wLength > sizeof(merlinx_ep0_tx_buf)) ? sizeof(merlinx_ep0_tx_buf) : wLength;
+			for (uint32_t i = 0; i < count; i++) {
+				merlinx_ep0_tx_buf[i] = (uint8_t)merlinx_log_ring[(offset + i) & MERLINX_LOG_RING_MASK];
+			}
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			native_musb_ep0_start_tx(merlinx_ep0_tx_buf, count, wLength);
+			return;
+		} else if (bRequest == 0xF2U) {
+			if (wLength == 0) {
+				musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_DATAEND);
+				native_musb_exec_command("help");
+			} else {
+				merlinx_ep0_rx_expected = (wLength > sizeof(merlinx_cmd_in) - 1) ?
+				    (sizeof(merlinx_cmd_in) - 1) : wLength;
+				merlinx_ep0_rx_off = 0;
+				merlinx_ep0_rx_req = 0xF2U;
+				musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			}
+			return;
+		} else if (bRequest == 0xF3U) {
+			uint32_t off = wValue;
+			uint32_t avail = (merlinx_cmd_out_len > off) ? (merlinx_cmd_out_len - off) : 0;
+			uint32_t count = (avail > wLength) ? wLength : avail;
+			if (count > sizeof(merlinx_ep0_tx_buf))
+				count = sizeof(merlinx_ep0_tx_buf);
+			if (count > 0)
+				memcpy(merlinx_ep0_tx_buf, merlinx_cmd_out + off, count);
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			native_musb_ep0_start_tx(merlinx_ep0_tx_buf, count, wLength);
+			return;
+		}
+	}
+
+	musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_SENDSTALL);
+}
+
+static void
+native_musb_poll_step(void)
+{
+	if (!merlinx_musb_base)
+		return;
+	merlinx_usb_polls++;
+
+	uint8_t intrusb = musb_read8(MUSB_INTRUSB);
+	(void)musb_read16(MUSB_INTRTX);
+	(void)musb_read16(MUSB_INTRRX);
+
+	if (intrusb & MUSB_INTR_RESET) {
+		merlinx_usb_resets++;
+		merlinx_usb_config = 0;
+		merlinx_usb_pending_addr = 0;
+		merlinx_ep0_tx_active = FALSE;
+		merlinx_ep0_rx_expected = 0;
+		musb_write8(MUSB_FADDR, 0);
+		musb_write8(MUSB_INDEX, 0);
+		musb_write16(MUSB_CSR0, MUSB_CSR0_FLUSHFIFO | MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_SVDSETUPEND);
+	}
+
+	uint8_t power = musb_read8(MUSB_POWER);
+	if ((power & (MUSB_POWER_SOFTCONN | MUSB_POWER_HSENAB)) != (MUSB_POWER_SOFTCONN | MUSB_POWER_HSENAB)) {
+		musb_write8(MUSB_POWER, MUSB_POWER_SOFTCONN | MUSB_POWER_HSENAB);
+	}
+
+	musb_write8(MUSB_INDEX, 0);
+	uint16_t csr0 = musb_read16(MUSB_CSR0);
+
+	if (csr0 & MUSB_CSR0_P_SENTSTALL) {
+		musb_write16(MUSB_CSR0, csr0 & ~MUSB_CSR0_P_SENTSTALL);
+		merlinx_ep0_tx_active = FALSE;
+		merlinx_ep0_rx_expected = 0;
+		csr0 = musb_read16(MUSB_CSR0);
+	}
+
+	if (csr0 & MUSB_CSR0_P_SETUPEND) {
+		musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDSETUPEND);
+		merlinx_ep0_tx_active = FALSE;
+		merlinx_ep0_rx_expected = 0;
+		csr0 = musb_read16(MUSB_CSR0);
+	}
+
+	if (merlinx_usb_pending_addr != 0 && !merlinx_ep0_tx_active &&
+	    (csr0 & (MUSB_CSR0_TXPKTRDY | MUSB_CSR0_RXPKTRDY)) == 0) {
+		musb_write8(MUSB_FADDR, merlinx_usb_pending_addr);
+		merlinx_usb_pending_addr = 0;
+	}
+
+	if (merlinx_ep0_tx_active) {
+		native_musb_ep0_pump_tx();
+		return;
+	}
+
+	if (csr0 & MUSB_CSR0_RXPKTRDY) {
+		uint8_t cnt = musb_read8(MUSB_COUNT0);
+		if (merlinx_ep0_rx_expected > 0) {
+			uint8_t tmp[64];
+			uint32_t rd = (cnt > sizeof(tmp)) ? sizeof(tmp) : cnt;
+			native_musb_ep0_fifo_read(tmp, rd);
+			for (uint32_t i = 0; i < rd && merlinx_ep0_rx_off < merlinx_ep0_rx_expected; i++) {
+				merlinx_cmd_in[merlinx_ep0_rx_off++] = (char)tmp[i];
+			}
+			if (merlinx_ep0_rx_off >= merlinx_ep0_rx_expected || rd < 64U) {
+				merlinx_cmd_in[merlinx_ep0_rx_off] = 0;
+				merlinx_ep0_rx_expected = 0;
+				musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY | MUSB_CSR0_P_DATAEND);
+				if (merlinx_ep0_rx_req == 0xF2U) {
+					merlinx_ep0_rx_req = 0;
+					native_musb_exec_command(merlinx_cmd_in);
+				}
+			} else {
+				musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+			}
+		} else if (cnt == 8U) {
+			uint8_t setup[8];
+			native_musb_ep0_fifo_read(setup, 8);
+			native_musb_handle_setup(setup);
+		} else {
+			uint8_t discard[64];
+			native_musb_ep0_fifo_read(discard, cnt > 64U ? 64U : cnt);
+			musb_write16(MUSB_CSR0, MUSB_CSR0_P_SVDRXPKTRDY);
+		}
+	}
+}
+
+static void
+native_musb_poll_timer(void *arg0 __unused, void *arg1 __unused)
+{
+	for (unsigned int i = 0; i < 32; i++) {
+		native_musb_poll_step();
+		if (!merlinx_ep0_tx_active && (musb_read16(MUSB_CSR0) & MUSB_CSR0_RXPKTRDY) == 0)
+			break;
+	}
+
+	if ((merlinx_usb_polls & 0x3FFU) == 0) {
+		char uline[48];
+		musb_write8(MUSB_INDEX, 0);
+		snprintf(uline, sizeof(uline), "U0 p:%02x a:%u c:%u s:%u r:%u %lluK",
+		    musb_read8(MUSB_POWER),
+		    musb_read8(MUSB_FADDR),
+		    merlinx_usb_config,
+		    merlinx_usb_setups % 10000U,
+		    merlinx_usb_resets % 100U,
+		    (unsigned long long)(merlinx_log_write_seq >> 10));
+		native_gop_text(27, uline);
+	}
+
+	uint64_t deadline = 0;
+	clock_interval_to_deadline(2, (uint32_t)NSEC_PER_MSEC, &deadline);
+	thread_call_enter_delayed(merlinx_musb_call, deadline);
+}
+
+static void
+native_musb_start(void)
+{
+	if (merlinx_musb_inited)
+		return;
+	merlinx_musb_inited = TRUE;
+
+	vm_offset_t musb_va   = ml_io_map(0x11200000ULL, 0x10000ULL);
+	vm_offset_t u2phy_va  = ml_io_map(0x11CC0000ULL, 0x10000ULL);
+	vm_offset_t topck_va  = ml_io_map(0x10000000ULL, 0x1000ULL);
+	vm_offset_t infra_va  = ml_io_map(0x10001000ULL, 0x1000ULL);
+	vm_offset_t peri_va   = ml_io_map(0x10003000ULL, 0x1000ULL);
+	vm_offset_t pwrap_va  = ml_io_map(0x1000D000ULL, 0x1000ULL);
+
+	merlinx_musb_base    = (volatile uint8_t *)musb_va;
+	merlinx_u2phy_base   = u2phy_va ? (volatile uint8_t *)(u2phy_va + 0x800ULL) : NULL;
+	merlinx_topck_base   = (volatile uint8_t *)topck_va;
+	merlinx_infra_base   = (volatile uint8_t *)infra_va;
+	merlinx_pericfg_base = (volatile uint8_t *)peri_va;
+	merlinx_pwrap_base   = (volatile uint8_t *)pwrap_va;
+
+	if (!merlinx_musb_base || !merlinx_u2phy_base) {
+		native_gop_text(27, "U0 MAP FAIL");
+		return;
+	}
+
+	native_musb_phy_and_clk_init();
+	native_musb_log_printf("[MUSB] Mode A EP0 PIO initialized: musb=%p u2phy=%p ring=%p (%u KiB)\n",
+	    (void *)merlinx_musb_base, (void *)merlinx_u2phy_base,
+	    (void *)merlinx_log_ring, MERLINX_LOG_RING_SIZE >> 10);
+
+	char uline[48];
+	musb_write8(MUSB_INDEX, 0);
+	snprintf(uline, sizeof(uline), "U0 p:%02x a:%u c:%u s:%u r:%u %lluK",
+	    musb_read8(MUSB_POWER), musb_read8(MUSB_FADDR), merlinx_usb_config,
+	    merlinx_usb_setups, merlinx_usb_resets,
+	    (unsigned long long)(merlinx_log_write_seq >> 10));
+	native_gop_text(27, uline);
+
+	merlinx_musb_call = thread_call_allocate(native_musb_poll_timer, NULL);
+	if (merlinx_musb_call) {
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(2, (uint32_t)NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(merlinx_musb_call, deadline);
+	}
+}
+
+void
+native_diag_focus_start(void)
+{
+	unsigned int i;
+	native_musb_start();
+	if (native_diag_focus_call)
+		return;
+	if (!native_diag_focus_configured)
+		native_diag_focus_configure();
+	for (i = 0; i < 4; i++)
+		if (native_diag_focus[i][0] && native_diag_focus_pid[i] > 0)
+			break;
+	if (i == 4)
+		return;
+	native_diag_focus_call = thread_call_allocate(native_diag_focus_sample, NULL);
+	if (native_diag_focus_call) {
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(4, (uint32_t)NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(native_diag_focus_call, deadline);
+	}
+}
+
+void
+native_diag_focus_note(int pid, const char *name)
+{
+	unsigned int i;
+	if (!native_diag_focus_configured)
+		native_diag_focus_configure();
+	for (i = 0; i < 4; i++) {
+		if (native_diag_focus[i][0] && native_diag_focus_same(native_diag_focus[i], name)) {
+			if (native_diag_focus_pid[i] > 0 && native_diag_focus_pid[i] != pid)
+				native_diag_focus_pid2[i] = native_diag_focus_pid[i];
+			native_diag_focus_pid[i] = pid;
+		}
+	}
+}
+
+void
+native_diag_focus_exit(int pid)
+{
+	unsigned int i;
+	for (i = 0; i < 4; i++) {
+		if (native_diag_focus_pid[i] == pid)
+			native_diag_focus_pid[i] = 0;
+		if (native_diag_focus_pid2[i] == pid)
+			native_diag_focus_pid2[i] = 0;
+	}
+}
