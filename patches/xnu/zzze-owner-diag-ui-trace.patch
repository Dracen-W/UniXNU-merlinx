diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index f4d58f0..e0f3045 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -62,6 +62,10 @@
 #include <vm/vm_fault.h>
 #include <vm/vm_kern.h>
 #include <vm/vm_shared_region.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <pexpert/pexpert.h>
+#include <mach/arm/thread_status.h>
 
 #include <sys/errno.h>
 #include <sys/kdebug.h>
@@ -2419,3 +2423,176 @@ recoverable_kernel_trap_test(__unused int64_t in, int64_t *out)
 SYSCTL_TEST_REGISTER(recoverable_kernel_trap, recoverable_kernel_trap_test);
 
 #endif
+
+/* ---------------------------------------------------------------------------------------------------------
+ * The UI trace of the documented boot arguments (boot-ui-focus, -focus2..4, boot-ui-chrono). It lives here, next
+ * to the exception code, because osfmk is where struct task and struct thread are complete and the saved state of
+ * another thread can be read: bsd only sees them as opaque types.
+ *
+ * Every 8 seconds one named process is sampled: the saved state of its first thread (PC, LR, SP and the x16
+ * syscall number) and two frame-chain returns. Addresses that live in the dyld shared cache are printed in
+ * cache coordinates (slide removed) so they can be matched against the cache's image list; the fields go on the
+ * free left lines 21..25, so the event ring keeps the launch history instead of scrolling it away.
+ * --------------------------------------------------------------------------------------------------------- */
+extern proc_t proc_find(int pid);
+extern task_t proc_task(proc_t p);
+extern void proc_rele(proc_t p);
+extern void native_gop_text(unsigned line, const char *text);
+
+
+static boolean_t
+native_diag_focus_same(const char *a, const char *b)
+{
+	if (!a || !b)
+		return FALSE;
+	while (*a && *a == *b) {
+		a++;
+		b++;
+	}
+	return *a == *b;
+}
+
+static char native_diag_focus[4][17];
+static int native_diag_focus_pid[4];
+static unsigned int native_diag_focus_slot;
+static boolean_t native_diag_focus_chrono;
+static boolean_t native_diag_focus_configured;
+static thread_call_t native_diag_focus_call;
+
+static void
+native_diag_focus_configure(void)
+{
+	static const char *const keys[4] = {"boot-ui-focus", "boot-ui-focus2", "boot-ui-focus3", "boot-ui-focus4"};
+	unsigned int chrono = 0, i;
+	for (i = 0; i < 4; i++) {
+		native_diag_focus[i][0] = 0;
+		if (!PE_parse_boot_arg_str(keys[i], native_diag_focus[i], sizeof(native_diag_focus[i])))
+			native_diag_focus[i][0] = 0;
+		if (native_diag_focus_same(native_diag_focus[i], "launchd"))
+			native_diag_focus_pid[i] = 1;
+	}
+	native_diag_focus_chrono = PE_parse_boot_argn("boot-ui-chrono", &chrono, sizeof(chrono)) && chrono != 0;
+	native_diag_focus_configured = TRUE;
+}
+
+static void
+native_diag_focus_sample(void *arg0 __unused, void *arg1 __unused)
+{
+	unsigned int slot = native_diag_focus_slot++ & 3;
+	const char *name = native_diag_focus[slot];
+	int pid = native_diag_focus_pid[slot];
+	proc_t p = NULL;
+	task_t task;
+	vm_map_t map;
+	thread_t thread = THREAD_NULL;
+	arm_thread_state64_t state = {};
+	mach_msg_type_number_t count = ARM_THREAD_STATE64_COUNT;
+	uint64_t slide = 0, frames[2] = {0, 0}, deadline = 0;
+	char line[48];
+	char seconds[16] = "";
+	char role = 'X';
+
+	if (name[0] == 'l' || name[0] == 'L')
+		role = 'L';
+	else if (name[0] == 'S')
+		role = 'S';
+	else if (name[0] == 'b' || name[0] == 'B')
+		role = 'B';
+	if (native_diag_focus_chrono) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		snprintf(seconds, sizeof(seconds), "%u.%02u ", (unsigned)(ns / 1000000000ULL),
+		    (unsigned)((ns / 10000000ULL) % 100));
+	}
+	if (!name[0] || pid <= 0)
+		goto reschedule;
+	p = proc_find(pid);
+	if (p == NULL) {
+		native_diag_focus_pid[slot] = 0;
+		goto reschedule;
+	}
+	task = proc_task(p);
+	if (!task)
+		goto release_proc;
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		thread_reference(thread);
+		break;
+	}
+	task_unlock(task);
+	if (thread == THREAD_NULL)
+		goto release_proc;
+	if (machine_thread_get_state(thread, ARM_THREAD_STATE64, (thread_state_t)&state, &count) != KERN_SUCCESS)
+		goto release_thread;
+	map = get_task_map(task);
+	if (task->shared_region)
+		slide = task->shared_region->sr_slide;
+	if (map && state.fp) {
+		uint64_t pair[2];
+		if (vm_map_read_user(map, state.fp, pair, sizeof(pair)) == KERN_SUCCESS) {
+			frames[0] = pair[1] - slide;
+			if (pair[0] > state.sp &&
+			    vm_map_read_user(map, pair[0], pair, sizeof(pair)) == KERN_SUCCESS)
+				frames[1] = pair[1] - slide;
+		}
+	}
+	snprintf(line, sizeof(line), "%c%d %spc %llx", role, pid, seconds, (unsigned long long)(state.pc - slide));
+	native_gop_text(21, line);
+	snprintf(line, sizeof(line), "%c%d %slr %llx", role, pid, seconds, (unsigned long long)(state.lr - slide));
+	native_gop_text(22, line);
+	snprintf(line, sizeof(line), "%c%d sp %llx x16 %llu", role, pid, (unsigned long long)state.sp,
+	    (unsigned long long)state.x[16]);
+	native_gop_text(23, line);
+	snprintf(line, sizeof(line), "%c%d f1 %llx", role, pid, (unsigned long long)frames[0]);
+	native_gop_text(24, line);
+	snprintf(line, sizeof(line), "%c%d f2 %llx", role, pid, (unsigned long long)frames[1]);
+	native_gop_text(25, line);
+release_thread:
+	thread_deallocate(thread);
+release_proc:
+	proc_rele(p);
+reschedule:
+	clock_interval_to_deadline(8, (uint32_t)NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(native_diag_focus_call, deadline);
+}
+
+void
+native_diag_focus_start(void)
+{
+	unsigned int i;
+	if (native_diag_focus_call)
+		return;
+	if (!native_diag_focus_configured)
+		native_diag_focus_configure();
+	for (i = 0; i < 4; i++)
+		if (native_diag_focus[i][0] && native_diag_focus_pid[i] > 0)
+			break;
+	if (i == 4)
+		return;
+	native_diag_focus_call = thread_call_allocate(native_diag_focus_sample, NULL);
+	if (native_diag_focus_call) {
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(8, (uint32_t)NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(native_diag_focus_call, deadline);
+	}
+}
+
+void
+native_diag_focus_note(int pid, const char *name)
+{
+	unsigned int i;
+	if (!native_diag_focus_configured)
+		native_diag_focus_configure();
+	for (i = 0; i < 4; i++)
+		if (native_diag_focus[i][0] && native_diag_focus_same(native_diag_focus[i], name))
+			native_diag_focus_pid[i] = pid;
+}
+
+void
+native_diag_focus_exit(int pid)
+{
+	unsigned int i;
+	for (i = 0; i < 4; i++)
+		if (native_diag_focus_pid[i] == pid)
+			native_diag_focus_pid[i] = 0;
+}
