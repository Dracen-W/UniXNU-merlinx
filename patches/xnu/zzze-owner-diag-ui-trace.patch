+static boolean_t native_diag_focus_chrono;
+static boolean_t native_diag_focus_configured;
+static thread_call_t native_diag_focus_call;
+
+static void
+native_diag_focus_configure(void)
+{
+	static const char *const keys[4] = {"boot-ui-focus", "boot-ui-focus2", "boot-ui-focus3", "boot-ui-focus4"};
+	unsigned int chrono = 0, i;
+	for (i = 0; i < 4; i++) {
+		native_diag_focus[i][0] = 0;
+		if (!PE_parse_boot_arg_str(keys[i], native_diag_focus[i], sizeof(native_diag_focus[i])))
+			native_diag_focus[i][0] = 0;
+		if (native_diag_focus_same(native_diag_focus[i], "launchd"))
+			native_diag_focus_pid[i] = 1;
+	}
+	native_diag_focus_chrono = PE_parse_boot_argn("boot-ui-chrono", &chrono, sizeof(chrono)) && chrono != 0;
+	native_diag_focus_configured = TRUE;
+}
+
+static void
+native_diag_focus_sample(void *arg0 __unused, void *arg1 __unused)
+{
+	unsigned int slot = 0, tries;
+	const char *name = "";
+	int pid = 0;
+	proc_t p = NULL;
+	task_t task;
+	vm_map_t map;
+	thread_t thread = THREAD_NULL;
+	arm_thread_state64_t state = {};
+	mach_msg_type_number_t count = ARM_THREAD_STATE64_COUNT;
+	uint64_t slide = 0, frames[12] = {0}, deadline = 0;
+	char line[48];
+	char seconds[16] = "";
+	char role = 'X';
+
+	for (tries = 0; tries < 4; tries++) {
+		slot = native_diag_focus_slot++ & 3;
+		if (native_diag_focus[slot][0] && (native_diag_focus_pid[slot] > 0 || native_diag_focus_pid2[slot] > 0)) {
+			name = native_diag_focus[slot];
+			if (native_diag_focus_pid[slot] > 0 && native_diag_focus_pid2[slot] > 0)
+				pid = ((native_diag_focus_slot >> 2) & 1) ? native_diag_focus_pid2[slot] : native_diag_focus_pid[slot];
+			else
+				pid = native_diag_focus_pid[slot] > 0 ? native_diag_focus_pid[slot] : native_diag_focus_pid2[slot];
+			break;
+		}
+	}
+	if (name[0] == 'l' && name[1] == 's')
+		role = 'D';
+	else if (name[0] == 'l' || name[0] == 'L')
+		role = 'L';
+	else if (name[0] == 'S')
+		role = 'S';
+	else if (name[0] == 'b' || name[0] == 'B')
+		role = 'B';
+	else if (name[0] == 'm' || name[0] == 'M')
+		role = 'M';
+	else if (name[0] == 'c' || name[0] == 'C')
+		role = 'C';
+	else if (name[0] == 'i' || name[0] == 'I')
+		role = 'I';
+	if (native_diag_focus_chrono) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		snprintf(seconds, sizeof(seconds), "%u.%02u ", (unsigned)(ns / 1000000000ULL),
+		    (unsigned)((ns / 10000000ULL) % 100));
+	}
+	if (!name[0] || pid <= 0)
+		goto reschedule;
+	p = proc_find(pid);
+	if (p == NULL) {
+		if (native_diag_focus_pid[slot] == pid)
+			native_diag_focus_pid[slot] = 0;
+		if (native_diag_focus_pid2[slot] == pid)
+			native_diag_focus_pid2[slot] = 0;
+		goto reschedule;
+	}
+	task = proc_task(p);
+	if (!task)
+		goto release_proc;
+	unsigned int nthreads = 0, pick_idx = 0, cur_idx = 0, step = 0;
+	thread_t iter_th = THREAD_NULL;
+	task_lock(task);
+	queue_iterate(&task->threads, iter_th, thread_t, task_threads) {
+		nthreads++;
+	}
+	if (nthreads > 0) {
+		unsigned int base_idx = (native_diag_focus_slot >> 2) % nthreads;
+		int best_tier = -1;
+		thread_t best_th = THREAD_NULL;
+		arm_thread_state64_t best_st = {};
+		unsigned int best_idx = 0;
+		for (step = 0; step < nthreads; step++) {
+			unsigned int want_idx = (base_idx + step) % nthreads;
+			cur_idx = 0;
+			queue_iterate(&task->threads, iter_th, thread_t, task_threads) {
+				if (cur_idx == want_idx) {
+					arm_thread_state64_t tmp_st = {};
+					mach_msg_type_number_t tmp_cnt = ARM_THREAD_STATE64_COUNT;
+					if (machine_thread_get_state(iter_th, ARM_THREAD_STATE64, (thread_state_t)&tmp_st, &tmp_cnt) == KERN_SUCCESS) {
+						long long sc = (long long)tmp_st.x[16];
+						boolean_t idle_sc = (tmp_st.pc == 0 || sc == 368 || sc == -368 || sc == 374 ||
+						    sc == -374 || sc == 375 || sc == -375 || sc == 410 || sc == -410);
+						boolean_t lock_sc = (sc == 515 || sc == -515 || sc == 544 || sc == -544 ||
+						    sc == 301 || sc == -301 || sc == 305 || sc == -305);
+						int tier = idle_sc ? 0 : (lock_sc ? 1 : 2);
+						if (tier > best_tier) {
+							best_tier = tier;
+							best_th = iter_th;
+							best_st = tmp_st;
+							best_idx = want_idx;
+						}
+					}
+					break;
+				}
+				cur_idx++;
+			}
+			if (best_tier == 2)
+				break;
+		}
+		if (best_th != THREAD_NULL) {
+			thread = best_th;
+			thread_reference(thread);
+			state = best_st;
+			pick_idx = best_idx;
+		}
+	}
+	task_unlock(task);
+	if (thread == THREAD_NULL)
+		goto release_proc;
+	map = get_task_map(task);
+	if (task->shared_region)
+		slide = task->shared_region->sr_slide;
+	if (map && state.fp) {
+		uint64_t fp = state.fp;
+		unsigned int d;
+		for (d = 0; d < 12 && fp > state.sp && (fp & 7ULL) == 0; d++) {
+			uint64_t pair[2] = {0, 0};
+			if (vm_map_read_user(map, fp, pair, sizeof(pair)) != KERN_SUCCESS)
+				break;
+			frames[d] = (pair[1] >= 0x180000000ULL && pair[1] >= slide) ? pair[1] - slide : pair[1];
+			if (pair[0] <= fp || pair[0] - fp > 0x100000ULL)
+				break;
+			fp = pair[0];
+		}
+	}
+	snprintf(line, sizeof(line), "%c%d/%u/%u %spc:%llx lr:%llx", role, pid, pick_idx, nthreads, seconds,
+	    (unsigned long long)((state.pc >= 0x180000000ULL && state.pc >= slide) ? state.pc - slide : state.pc),
+	    (unsigned long long)((state.lr >= 0x180000000ULL && state.lr >= slide) ? state.lr - slide : state.lr));
+	native_gop_text(21, line);
+	{
+		extern void native_musb_log_printf(const char *fmt, ...);
+		native_musb_log_printf("[FOCUS] %c%d(%s) tid=%u/%u %spc=%llx lr=%llx x16=%lld x0=%llx x1=%llx "
+		    "f1=%llx f2=%llx f3=%llx f4=%llx f5=%llx f6=%llx f7=%llx f8=%llx f9=%llx f10=%llx f11=%llx f12=%llx\n",
+		    role, pid, name, pick_idx, nthreads, seconds,
+		    (unsigned long long)((state.pc >= 0x180000000ULL && state.pc >= slide) ? state.pc - slide : state.pc),
+		    (unsigned long long)((state.lr >= 0x180000000ULL && state.lr >= slide) ? state.lr - slide : state.lr),
+		    (long long)state.x[16], (unsigned long long)state.x[0], (unsigned long long)state.x[1],
+		    (unsigned long long)frames[0], (unsigned long long)frames[1],
+		    (unsigned long long)frames[2], (unsigned long long)frames[3],
+		    (unsigned long long)frames[4], (unsigned long long)frames[5],
+		    (unsigned long long)frames[6], (unsigned long long)frames[7],
+		    (unsigned long long)frames[8], (unsigned long long)frames[9],
+		    (unsigned long long)frames[10], (unsigned long long)frames[11]);
+	}
+	if (frames[6] != 0) {
+		snprintf(line, sizeof(line), "%c%d x16:%lld f5:%llx f6:%llx", role, pid,
+		    (long long)state.x[16], (unsigned long long)frames[4], (unsigned long long)frames[5]);
+		native_gop_text(22, line);
+		snprintf(line, sizeof(line), "%c%d f7:%llx f8:%llx", role, pid,
+		    (unsigned long long)frames[6], (unsigned long long)frames[7]);
+		native_gop_text(23, line);
+		snprintf(line, sizeof(line), "%c%d f9:%llx f10:%llx", role, pid,
+		    (unsigned long long)frames[8], (unsigned long long)frames[9]);
+		native_gop_text(24, line);
+		snprintf(line, sizeof(line), "%c%d f11:%llx f12:%llx", role, pid,
+		    (unsigned long long)frames[10], (unsigned long long)frames[11]);
+		native_gop_text(25, line);
+	} else {
+		snprintf(line, sizeof(line), "%c%d x16:%lld f1:%llx f2:%llx", role, pid,
+		    (long long)state.x[16], (unsigned long long)frames[0], (unsigned long long)frames[1]);
+		native_gop_text(22, line);
+		snprintf(line, sizeof(line), "%c%d f3:%llx f4:%llx", role, pid,
+		    (unsigned long long)frames[2], (unsigned long long)frames[3]);
+		native_gop_text(23, line);
+		snprintf(line, sizeof(line), "%c%d f5:%llx f6:%llx", role, pid,
+		    (unsigned long long)frames[4], (unsigned long long)frames[5]);
+		native_gop_text(24, line);
+		snprintf(line, sizeof(line), "%c%d f7:%llx f8:%llx", role, pid,
+		    (unsigned long long)frames[6], (unsigned long long)frames[7]);
+		native_gop_text(25, line);
+	}
+release_thread:
+	thread_deallocate(thread);
+release_proc:
+	proc_rele(p);
+reschedule:
+	native_diag_process_summary();
+	native_gop_redraw_ring();
+	clock_interval_to_deadline(4, (uint32_t)NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(native_diag_focus_call, deadline);
+}
+
+/* =========================================================================================================
+ * Mode A: MT6768 MUSB EP0 PIO Diagnostic & Live Kernel Log Ring Driver (VID 0x05AC / PID 0x12A8, WinUSB)
+ *
+ * Exposes a 4 MiB in-RAM ring buffer (`merlinx_log_ring`) plus a live command engine over USB Control
+ * Transfers (EP0 PIO, no interrupts or DMA required). Compatible with Linux/macOS/Windows via pyusb/libusb.
+ * ========================================================================================================= */
+#define MERLINX_LOG_RING_SHIFT 22U
+#define MERLINX_LOG_RING_SIZE  (1U << MERLINX_LOG_RING_SHIFT) /* 4 MiB */
+#define MERLINX_LOG_RING_MASK  (MERLINX_LOG_RING_SIZE - 1U)
+
+#define MERLINX_CMD_OUT_SIZE   65536U
+
+struct merlinx_usb_status_pkt {
+	uint32_t magic;        /* 0x4D584C47 'MXLG' */
+	uint32_t ring_size;    /* 4 MiB */
+	uint64_t write_seq;    /* total bytes written to merlinx_log_ring */
+	uint64_t uptime_cs;    /* centiseconds since boot */
+	uint32_t usb_polls;    /* poll loop iterations */
+	uint32_t usb_resets;   /* USB bus resets seen */
+	uint32_t usb_setups;   /* EP0 SETUP packets handled */
+	uint32_t cmd_seq;      /* completed command sequence */
+	uint32_t cmd_len;      /* bytes in merlinx_cmd_out */
+	uint8_t  faddr;        /* current USB function address */
+	uint8_t  power;        /* MUSB POWER register */
+	uint8_t  devctl;       /* MUSB DEVCTL register */
+	uint8_t  config;       /* active configuration */
+} __attribute__((packed));
+
+char merlinx_log_ring[MERLINX_LOG_RING_SIZE] __attribute__((aligned(64)));
+volatile uint64_t merlinx_log_write_seq = 0;
+
+static char merlinx_cmd_in[128];
+static char merlinx_cmd_out[MERLINX_CMD_OUT_SIZE];
+static volatile uint32_t merlinx_cmd_out_len = 0;
+static volatile uint32_t merlinx_cmd_seq = 0;
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern const char *native_diag_xp_lookup(int pid);
+extern int psignal(proc_t p, int sig);
+extern volatile uint32_t native_diag_block_iconservices;
+
+static void
+native_musb_ring_write(const char *buf, size_t len)
+{
+	if (!buf || len == 0)
+		return;
+	uint64_t start = __atomic_fetch_add(&merlinx_log_write_seq, (uint64_t)len, __ATOMIC_RELAXED);
+	for (size_t i = 0; i < len; i++) {
+		merlinx_log_ring[(start + i) & MERLINX_LOG_RING_MASK] = buf[i];
+	}
+}
+
+void
+native_musb_log_putc(int c)
+{
+	char ch = (char)c;
+	native_musb_ring_write(&ch, 1);
+}
+
+void
+native_musb_log_printf(const char *fmt, ...)
+{
+	char buf[384];
+	va_list ap;
+	if (!fmt)
+		return;
+	va_start(ap, fmt);
+	int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (n <= 0)
+		return;
+	if ((size_t)n >= sizeof(buf))
+		n = (int)(sizeof(buf) - 1);
+	native_musb_ring_write(buf, (size_t)n);
+}
+
+void
+native_musb_log_gop(unsigned line, const char *text)
+{
+	if (!text || !text[0])
+		return;
+	if (line < 100) {
+		static char last_left[100][48];
+		if (strncmp(last_left[line], text, sizeof(last_left[line]) - 1) == 0)
+			return;
+		strlcpy(last_left[line], text, sizeof(last_left[line]));
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	unsigned int s = (unsigned int)(ns / 1000000000ULL);
+	unsigned int cs = (unsigned int)((ns / 10000000ULL) % 100ULL);
+	if (line >= 100)
+		native_musb_log_printf("[%u.%02u][RING] %s\n", s, cs, text);
+	else
+		native_musb_log_printf("[%u.%02u][L%02u] %s\n", s, cs, line, text);
+}
+
+void
+native_musb_log_fault(const char *tag, int pid, const char *name,
+    arm_saved_state64_t *ss, uint64_t slide, const uint64_t *frames,
+    uint32_t insn_prev, uint32_t insn_pc)
+{
+	if (!ss)
+		return;
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	unsigned int s = (unsigned int)(ns / 1000000000ULL);
+	unsigned int cs = (unsigned int)((ns / 10000000ULL) % 100ULL);
+	uint64_t pc_u = (ss->pc >= 0x180000000ULL && ss->pc >= slide) ? ss->pc - slide : ss->pc;
+	uint64_t lr_u = (ss->lr >= 0x180000000ULL && ss->lr >= slide) ? ss->lr - slide : ss->lr;
+	native_musb_log_printf(
+	    "[%u.%02u][FAULT] %s pid=%d comm=%s pc=%llx(raw:%llx) lr=%llx(raw:%llx) sp=%llx fp=%llx far=%llx esr=%x slide=%llx insn=%08x/%08x\n"
+	    "  x0=%llx x1=%llx x2=%llx x3=%llx x4=%llx x5=%llx x6=%llx x7=%llx x8=%llx x16=%lld\n"
+	    "  bt: f1=%llx f2=%llx f3=%llx f4=%llx f5=%llx f6=%llx f7=%llx f8=%llx f9=%llx f10=%llx f11=%llx f12=%llx\n",
+	    s, cs, tag ? tag : "UG", pid, name ? name : "?",
+	    (unsigned long long)pc_u, (unsigned long long)ss->pc,
+	    (unsigned long long)lr_u, (unsigned long long)ss->lr,
+	    (unsigned long long)ss->sp, (unsigned long long)ss->fp,
+	    (unsigned long long)ss->far, (unsigned int)ss->esr,
+	    (unsigned long long)slide, insn_prev, insn_pc,
+	    (unsigned long long)ss->x[0], (unsigned long long)ss->x[1],
+	    (unsigned long long)ss->x[2], (unsigned long long)ss->x[3],
+	    (unsigned long long)ss->x[4], (unsigned long long)ss->x[5],
+	    (unsigned long long)ss->x[6], (unsigned long long)ss->x[7],
+	    (unsigned long long)ss->x[8], (long long)ss->x[16],
+	    frames ? (unsigned long long)frames[0] : 0ULL,
+	    frames ? (unsigned long long)frames[1] : 0ULL,
+	    frames ? (unsigned long long)frames[2] : 0ULL,
+	    frames ? (unsigned long long)frames[3] : 0ULL,
+	    frames ? (unsigned long long)frames[4] : 0ULL,
+	    frames ? (unsigned long long)frames[5] : 0ULL,
+	    frames ? (unsigned long long)frames[6] : 0ULL,
+	    frames ? (unsigned long long)frames[7] : 0ULL,
+	    frames ? (unsigned long long)frames[8] : 0ULL,
+	    frames ? (unsigned long long)frames[9] : 0ULL,
+	    frames ? (unsigned long long)frames[10] : 0ULL,
+	    frames ? (unsigned long long)frames[11] : 0ULL);
+}
