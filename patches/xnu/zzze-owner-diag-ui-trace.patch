+/* Repeated exec/exit events are what fills the 64-line ring and hides the boot order (xpcproxy restarts endlessly). Keep the
+ * first three events of a name and then every 64th: the boot history stays readable while a loop remains visible. */
+#define NATIVE_DIAG_THROTTLE_SLOTS 8
+struct native_diag_throttle {
+	char name[17];
+	unsigned int count;
+};
+static struct native_diag_throttle native_diag_exec_throttle[NATIVE_DIAG_THROTTLE_SLOTS];
+static struct native_diag_throttle native_diag_exit_throttle[NATIVE_DIAG_THROTTLE_SLOTS];
