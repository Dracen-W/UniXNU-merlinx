+static void
+native_musb_dump_proc_bt(proc_t p, boolean_t mirror_to_ring)
+{
+	if (!p)
+		return;
+	int pid = p->p_pid;
+	const char *nm = p->p_name[0] ? p->p_name : p->p_comm;
+	const char *xtag = native_diag_xp_lookup(pid);
+	task_t task = proc_task(p);
+	if (!task) {
+		native_musb_cmd_append("PID %d (%s%s%s): no task\n",
+		    pid, nm, xtag ? ":" : "", xtag ? xtag : "");
+		return;
+	}
+	vm_map_t map = get_task_map(task);
+	uint64_t slide = (task->shared_region) ? task->shared_region->sr_slide : 0;
+	thread_t th = THREAD_NULL;
+	unsigned int tidx = 0, nthreads = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		nthreads++;
+	}
+	native_musb_cmd_append("PID %d (%s%s%s) threads=%u slide=0x%llx\n",
+	    pid, nm, xtag ? ":" : "", xtag ? xtag : "", nthreads, (unsigned long long)slide);
+	if (mirror_to_ring)
+		native_musb_log_printf("[CMD-BT] PID %d (%s%s%s) threads=%u slide=0x%llx\n",
+		    pid, nm, xtag ? ":" : "", xtag ? xtag : "", nthreads, (unsigned long long)slide);
+
+	struct {
+		arm_thread_state64_t st;
+		boolean_t valid;
+	} snaps[16];
+	unsigned int cap = nthreads < 16 ? nthreads : 16;
+	tidx = 0;
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (tidx >= cap)
+			break;
+		mach_msg_type_number_t cnt = ARM_THREAD_STATE64_COUNT;
+		memset(&snaps[tidx].st, 0, sizeof(snaps[tidx].st));
+		snaps[tidx].valid = (machine_thread_get_state(th, ARM_THREAD_STATE64,
+		    (thread_state_t)&snaps[tidx].st, &cnt) == KERN_SUCCESS);
+		tidx++;
+	}
+	task_unlock(task);
+
+	for (tidx = 0; tidx < cap; tidx++) {
+		if (!snaps[tidx].valid)
+			continue;
+		arm_thread_state64_t *st = &snaps[tidx].st;
+		uint64_t frames[12] = {0};
+		if (map && st->fp) {
+			uint64_t fp = st->fp;
+			for (unsigned int d = 0; d < 12 && fp > st->sp && (fp & 7ULL) == 0; d++) {
+				uint64_t pair[2] = {0, 0};
+				if (vm_map_read_user(map, fp, pair, sizeof(pair)) != KERN_SUCCESS)
+					break;
+				frames[d] = (pair[1] >= 0x180000000ULL && pair[1] >= slide) ? pair[1] - slide : pair[1];
+				if (pair[0] <= fp || pair[0] - fp > 0x100000ULL)
+					break;
+				fp = pair[0];
+			}
+		}
+		uint64_t pc_u = (st->pc >= 0x180000000ULL && st->pc >= slide) ? st->pc - slide : st->pc;
+		uint64_t lr_u = (st->lr >= 0x180000000ULL && st->lr >= slide) ? st->lr - slide : st->lr;
+		native_musb_cmd_append(
+		    "  [T%u] pc=%llx lr=%llx sp=%llx fp=%llx x16=%lld x0=%llx x1=%llx\n"
+		    "       bt: %llx -> %llx -> %llx -> %llx -> %llx -> %llx -> %llx -> %llx -> %llx -> %llx -> %llx -> %llx\n",
+		    tidx,
+		    (unsigned long long)pc_u, (unsigned long long)lr_u,
+		    (unsigned long long)st->sp, (unsigned long long)st->fp,
+		    (long long)st->x[16], (unsigned long long)st->x[0], (unsigned long long)st->x[1],
+		    (unsigned long long)frames[0], (unsigned long long)frames[1],
+		    (unsigned long long)frames[2], (unsigned long long)frames[3],
+		    (unsigned long long)frames[4], (unsigned long long)frames[5],
+		    (unsigned long long)frames[6], (unsigned long long)frames[7],
+		    (unsigned long long)frames[8], (unsigned long long)frames[9],
+		    (unsigned long long)frames[10], (unsigned long long)frames[11]);
+		if (mirror_to_ring) {
+			native_musb_log_printf(
+			    "  [T%u] pc=%llx lr=%llx x16=%lld x0=%llx bt:%llx/%llx/%llx/%llx/%llx/%llx/%llx/%llx/%llx/%llx/%llx/%llx\n",
+			    tidx, (unsigned long long)pc_u, (unsigned long long)lr_u,
+			    (long long)st->x[16], (unsigned long long)st->x[0],
+			    (unsigned long long)frames[0], (unsigned long long)frames[1],
+			    (unsigned long long)frames[2], (unsigned long long)frames[3],
+			    (unsigned long long)frames[4], (unsigned long long)frames[5],
+			    (unsigned long long)frames[6], (unsigned long long)frames[7],
+			    (unsigned long long)frames[8], (unsigned long long)frames[9],
+			    (unsigned long long)frames[10], (unsigned long long)frames[11]);
+		}
+	}
+}
