+		slot = native_diag_focus_slot++ & 3;
+		if (native_diag_focus[slot][0] && native_diag_focus_pid[slot] > 0) {
+			name = native_diag_focus[slot];
+			pid = native_diag_focus_pid[slot];
+			break;
+		}
+	}
+	if (name[0] == 'l' && name[1] == 's')
+		role = 'D';
+	else if (name[0] == 'l' || name[0] == 'L')
+		role = 'L';
+	else if (name[0] == 'S')
