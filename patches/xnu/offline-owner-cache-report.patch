 static void
 proc_handle_critical_exit(proc_t p, int rv)
 {
@@ -1865,12 +1896,31 @@ proc_handle_critical_exit(proc_t p, int rv)
 
 	sync(p, (void *)NULL, (int *)NULL);
 
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+	char owner_diag[512];
+	snprintf(owner_diag, sizeof(owner_diag),
+	    "owner st=%d s=%d m=%d ro=%d a=%d r=%d u=%d f=%llx op=%d/%d stt=%d/%d fst=%d/%d pre=%d/%d fcn=%d/%d car=%lu/%lu path=%s",
+	    native_owner_cache_stage, native_owner_cache_status, native_owner_cache_mount_status,
+	    native_owner_cache_readonly, native_owner_cache_authorized, native_owner_cache_root_recheck,
+	    native_owner_cache_native_union, (unsigned long long)native_owner_cache_dyld_flags,
+	    native_owner_cache_open_calls, native_owner_cache_open_last_error,
+	    native_owner_cache_stat_calls, native_owner_cache_stat_last_error,
+	    native_owner_cache_fstat_calls, native_owner_cache_fstat_last_error,
+	    native_owner_cache_pread_calls, native_owner_cache_pread_last_error,
+	    native_owner_cache_fcntl_calls, native_owner_cache_fcntl_last_error,
+	    OWNER_CACHE_CARRIER_ACCEPTS, OWNER_CACHE_CARRIER_REJECTS,
+	    native_owner_cache_open_last_path);
+	printf("owner cache: %s\n", owner_diag);
+#else
+	const char *owner_diag = "";
+#endif
+
 	if (p->p_exit_reason == OS_REASON_NULL) {
-		panic_with_options(0, NULL, DEBUGGER_OPTION_INITPROC_PANIC, "%s -- no exit reason available -- (signal %d, exit status %d %s)",
-		    prefix_str, WTERMSIG(rv), WEXITSTATUS(rv), ((proc_getcsflags(p) & CS_KILLED) ? "CS_KILLED" : ""));
+		panic_with_options(0, NULL, DEBUGGER_OPTION_INITPROC_PANIC, "[%s] %s -- no exit reason available -- (signal %d, exit status %d %s)",
+		    owner_diag, prefix_str, WTERMSIG(rv), WEXITSTATUS(rv), ((proc_getcsflags(p) & CS_KILLED) ? "CS_KILLED" : ""));
 	} else {
-		panic_with_options(0, NULL, DEBUGGER_OPTION_INITPROC_PANIC, "%s %s -- exit reason namespace %d subcode 0x%llx description: %." LAUNCHD_PANIC_REASON_STRING_MAXLEN "s",
-		    ((proc_getcsflags(p) & CS_KILLED) ? "CS_KILLED" : ""),
+		panic_with_options(0, NULL, DEBUGGER_OPTION_INITPROC_PANIC, "[%s] %s %s -- exit reason namespace %d subcode 0x%llx description: %." LAUNCHD_PANIC_REASON_STRING_MAXLEN "s",
+		    owner_diag, ((proc_getcsflags(p) & CS_KILLED) ? "CS_KILLED" : ""),
