diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 4910ce4..2e4cc1e 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -3087,6 +3087,8 @@ extern volatile uint32_t armcpu_core_timer[8] __attribute__((weak));
 extern volatile uint32_t armcpu_core_sgi[8] __attribute__((weak));
 extern volatile uint32_t armcpu_cpu_init_completed __attribute__((weak));
 extern unsigned armcpu_stats_row(unsigned index, char *row, unsigned size) __attribute__((weak));
+extern volatile uint64_t merlinx_smp_crumb[8][4];
+volatile uint64_t merlinx_smp_crumb[8][4] __attribute__((aligned(64))) = {{0}};
 
 #define MERLINX_SMP_MAX_CPUS 8U
 
@@ -3257,6 +3259,25 @@ native_musb_cmd_smp(void)
 			native_musb_cmd_append("%s\n", row);
 		}
 	}
+	{
+		uintptr_t _va;
+		for (_va = (uintptr_t)merlinx_smp_crumb;
+		    _va < (uintptr_t)merlinx_smp_crumb + sizeof(merlinx_smp_crumb);
+		    _va += 64) {
+			__asm__ volatile ("dc civac, %0" :: "r"(_va) : "memory");
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		native_musb_cmd_append("[smp-crumb]");
+		for (unsigned int _ci = 0; _ci < 8U; _ci++) {
+			native_musb_cmd_append(" s%u:st=%llu/m=%llx/el=%llx/cd=%llx",
+			    _ci,
+			    (unsigned long long)merlinx_smp_crumb[_ci][0],
+			    (unsigned long long)merlinx_smp_crumb[_ci][1],
+			    (unsigned long long)merlinx_smp_crumb[_ci][2],
+			    (unsigned long long)merlinx_smp_crumb[_ci][3]);
+		}
+		native_musb_cmd_append("\n");
+	}
 }
 
